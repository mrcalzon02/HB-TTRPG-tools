{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-adaptive-spatiotemporal-refinement.schema.json",
  "title": "Black Light FTL Adaptive Spatiotemporal Refinement Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "familyId", "encounterModel", "sampling", "samples", "refinementEvents", "warnings", "provenance", "canonSafeguards"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["RESOLVED", "PARTIAL", "UNRESOLVED", "OUTSIDE_MODEL_VALIDITY", "CONFLICT"]},
    "familyId": {"type": ["string", "null"]},
    "encounterModel": {"enum": ["CONTINUOUS_PROJECTED_PROGRESS", "PRECOMMIT_ENDPOINT", "ANCHORED_PORTAL", "UNRESOLVED"]},
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptive", "initialSampleCount", "finalSampleCount", "maximumSampleCount", "maximumDepth", "tolerances"],
      "properties": {
        "adaptive": {"type": "boolean"},
        "initialSampleCount": {"type": "integer", "minimum": 0},
        "finalSampleCount": {"type": "integer", "minimum": 0},
        "maximumSampleCount": {"type": "integer", "minimum": 2},
        "maximumDepth": {"type": "integer", "minimum": 0},
        "tolerances": {"type": "object"}
      }
    },
    "samples": {"type": "array", "items": {"type": "object"}},
    "refinementEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["depth", "leftFraction", "rightFraction", "midFraction", "reasons"],
        "properties": {
          "depth": {"type": "integer", "minimum": 0},
          "leftFraction": {"type": "number", "minimum": 0, "maximum": 1},
          "rightFraction": {"type": "number", "minimum": 0, "maximum": 1},
          "midFraction": {"type": "number", "minimum": 0, "maximum": 1},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "canonSafeguards": {"type": "array", "items": {"type": "string"}}
  }
}
