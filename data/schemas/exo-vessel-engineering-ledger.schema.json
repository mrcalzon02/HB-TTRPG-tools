defs/allocation"},"structural":{"$ref":"#/$defs/allocation"},"citadel":{"$ref":"#/$defs/allocation"}}},"layers":{"type":"array","minItems":5,"items":{"type":"object"}},"facings":{"$ref":"#/$defs/directionalMap"},"fieldFacings":{"$ref":"#/$defs/directionalMap"},"distributionRule":{"type":"string","minLength":1},"relativisticBoundary":{"type":"string","minLength":1},"validation":{"$ref":"#/$defs/validation"}}},
