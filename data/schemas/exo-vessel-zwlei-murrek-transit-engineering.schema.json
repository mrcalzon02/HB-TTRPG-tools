{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-zwlei-murrek-transit-engineering.schema.json",
  "title": "Zwlei Mur'rek Propulsion and Transit Engineering Profile",
  "description": "Canon-safe machine-readable profile for the named Mur'rek-class Zwlei patrol frigate. Preserves confirmed gravitic-slipstream machinery without silently equating local source terminology to a Black Light FTL family.",
  "type": "object",
  "required": [
    "recordType",
    "recordVersion",
    "authority",
    "subject",
    "confirmedInstallation",
    "familyResolution",
    "engineeringModel",
    "generationRules",
    "apiContract",
    "canonSafeguards"
  ],
  "properties": {
    "recordType": {"const": "zwleiMurrekTransitEngineeringProfile"},
    "recordVersion": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["status", "precedence", "sources", "sourceDocument", "sourceDocumentId"],
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": ["civilizationOrSpecies", "vesselClass", "role", "environment", "sourceStatus"],
      "additionalProperties": true
    },
    "confirmedInstallation": {
      "type": "object",
      "required": [
        "sourceTerm",
        "sourceStatus",
        "documentedFunctions",
        "documentedComponents",
        "documentedControls",
        "documentedSensors",
        "documentedPowerAndMedia",
        "documentedFailureHazards"
      ],
      "additionalProperties": true
    },
    "familyResolution": {
      "type": "object",
      "required": ["status", "reason", "admissibleComparisons", "forbiddenPromotion"],
      "properties": {
        "status": {"const": "UNRESOLVED"},
        "reason": {"type": "string", "minLength": 1},
        "admissibleComparisons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbiddenPromotion": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "engineeringModel": {
      "type": "object",
      "required": [
        "machinery",
        "power",
        "navigation",
        "control",
        "maintenance",
        "signature",
        "failure",
        "infrastructure",
        "scaling",
        "mathematics",
        "procedures"
      ],
      "additionalProperties": true
    },
    "generationRules": {
      "type": "object",
      "required": ["authorityOnly", "labeledDerivation", "labeledProposal", "terminologyFirewall", "derelictRule"],
      "additionalProperties": true
    },
    "apiContract": {
      "type": "object",
      "required": ["resolver", "inputs", "outputs", "hardFailures"],
      "additionalProperties": true
    },
    "canonSafeguards": {
      "type": "array",
      "minItems": 8,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
