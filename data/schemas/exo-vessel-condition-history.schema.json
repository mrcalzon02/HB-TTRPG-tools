{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-condition-history.schema.json",
  "title":"Blacklight EXO Vessel Condition History",
  "description":"VESSEL-05 lifecycle history, module condition, surviving graphs, pressure and route state, wreck coherence, residual statistics, repair log, and later-phase deferrals.",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","vesselInstanceId","conditionSeed","historySeed","activeTemplate","serviceDoctrine","axes","lifecycleState","coherentVesselGraph","validationMode","referenceAuthority","events","moduleStates","zoneStates","routeStates","loadPathStates","effectiveGraphs","recalculated","repairLog","deferredSystems","validation"],
  "properties":{
    "recordType":{"const":"exoVesselConditionHistory"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-05"},
    "vesselInstanceId":{"type":"string","pattern":"^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "conditionSeed":{"type":"string","minLength":1},
    "historySeed":{"type":"string","minLength":1},
    "activeTemplate":{"enum":["NEWLY_MANUFACTURED","PARTIALLY_COMPLETED","COMMISSIONING","OPERATIONAL","WORN_SERVICE","PARTIALLY_TORN_DOWN","MOTHBALLED","ABANDONED","PARTIALLY_SALVAGED","DAMAGED","CRIPPLED","WRECKED","DESTROYED"]},
    "serviceDoctrine":{"enum":["CIVILIAN","MERCHANT","PASSENGER","INDUSTRIAL","SCIENTIFIC","COLONIAL","GOVERNMENT","PARAMILITARY","MILITARY","PIRATE_OR_IRREGULAR","ABANDONED_OR_UNKNOWN"]},
    "axes":{"$ref":"exo-vessel-condition.schema.json#/properties/axes"},
    "lifecycleState":{"type":"string","minLength":1},
    "coherentVesselGraph":{"type":"boolean"},
    "validationMode":{"enum":["REPAIR","STRICT"]},
    "referenceAuthority":{"type":"object","additionalProperties":false,"required":["moduleGraph","voxelLayout"],"properties":{"moduleGraph":{"const":"VESSEL-03_INTACT_REFERENCE"},"voxelLayout":{"const":"VESSEL-04_INTACT_REFERENCE"}}},
    "events":{"type":"array","items":{"$ref":"#/$defs/event"}},
    "moduleStates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/moduleState"}},
    "zoneStates":{"type":"array","items":{"$ref":"#/$defs/zoneState"}},
    "routeStates":{"type":"array","items":{"$ref":"#/$defs/routeState"}},
    "loadPathStates":{"type":"array","items":{"$ref":"#/$defs/loadPathState"}},
    "effectiveGraphs":{"type":"object","additionalProperties":false,"required":["structural","power","cooling","data","atmosphere","access","magazineFeed","sensorDependency"],"properties":{"structural":{"$ref":"#/$defs/network"},"power":{"$ref":"#/$defs/network"},"cooling":{"$ref":"#/$defs/network"},"data":{"$ref":"#/$defs/network"},"atmosphere":{"$ref":"#/$defs/network"},"access":{"$ref":"#/$defs/network"},"magazineFeed":{"$ref":"#/$defs/network"},"sensorDependency":{"$ref":"#/$defs/network"}}},
    "recalculated":{"$ref":"#/$defs/recalculated"},
    "repairLog":{"type":"array","items":{"$ref":"#/$defs/repair"}},
    "deferredSystems":{"type":"object","additionalProperties":false,"required":["trackAndCombatGeometry","weaponEngagementEnvelopes","localHitResolution"],"properties":{"trackAndCombatGeometry":{"const":"VESSEL-06"},"weaponEngagementEnvelopes":{"const":"VESSEL-07"},"localHitResolution":{"const":"VESSEL-08"}}},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "event":{"type":"object","additionalProperties":false,"required":["eventId","sequence","eventType","timestampMode","targetType","targetIds","magnitude","source","description","propagationId","deterministic"],"properties":{"eventId":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":1},"eventType":{"enum":["CONSTRUCTION_SHORTFALL","COMMISSIONING_PROGRESS","SERVICE_WEAR","MAINTENANCE_DEBT","MOTHBALL","REACTIVATION","DECOMMISSION","TEARDOWN_REMOVAL","ABANDONMENT","SALVAGE_REMOVAL","STRUCTURAL_DAMAGE","SYSTEM_DAMAGE","ATMOSPHERE_LOSS","CONTAMINATION","DATA_CORRUPTION","FUEL_DEPLETION","COOLANT_LOSS","DESTRUCTION","SECONDARY_PROPAGATION"]},"timestampMode":{"const":"RELATIVE_ORDER"},"targetType":{"enum":["VESSEL","MODULE","ZONE","ROUTE","LOAD_PATH"]},"targetIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"magnitude":{"type":"number","minimum":0,"maximum":100},"source":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"propagationId":{"type":["string","null"]},"deterministic":{"const":true}}},
    "moduleState":{"type":"object","additionalProperties":false,"required":["moduleId","constructionPercent","commissioningPercent","damagePercent","salvageRemovalPercent","maintenanceDebtPercent","contaminationPercent","operational","applicationStatus","installationState","serviceState","disposition","graphParticipation","conditionPercent","residualMassTonnes","residualVolumeM3","salvageableMassTonnes","failureModes","eventIds"],"properties":{"moduleId":{"type":"string","pattern":"^module-[a-z0-9][a-z0-9-]{5,95}$"},"constructionPercent":{"type":"number","minimum":0,"maximum":100},"commissioningPercent":{"type":"number","minimum":0,"maximum":100},"damagePercent":{"type":"number","minimum":0,"maximum":100},"salvageRemovalPercent":{"type":"number","minimum":0,"maximum":100},"maintenanceDebtPercent":{"type":"number","minimum":0,"maximum":100},"contaminationPercent":{"type":"number","minimum":0,"maximum":100},"operational":{"type":"boolean"},"applicationStatus":{"const":"CONDITION_APPLIED"},"installationState":{"enum":["INSTALLED","INCOMPLETE","MISSING","REMOVED","DESTROYED"]},"serviceState":{"enum":["OPERATIONAL","DEGRADED","OFFLINE","ISOLATED","MOTHBALLED","ABANDONED","WRECKAGE"]},"disposition":{"enum":["NONE","MISSING_CONSTRUCTION","TEARDOWN","SALVAGE","DAMAGE","DESTRUCTION"]},"graphParticipation":{"enum":["ACTIVE","PHYSICAL_ONLY","NONE"]},"conditionPercent":{"type":"number","minimum":0,"maximum":100},"residualMassTonnes":{"type":"number","minimum":0},"residualVolumeM3":{"type":"number","minimum":0},"salvageableMassTonnes":{"type":"number","minimum":0},"failureModes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"eventIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "zoneState":{"type":"object","additionalProperties":false,"required":["zoneId","label","referenceModuleCount","physicalModuleCount","activeModuleCount","atmosphereIntegrityPercent","contaminationPercent","state"],"properties":{"zoneId":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"referenceModuleCount":{"type":"integer","minimum":0},"physicalModuleCount":{"type":"integer","minimum":0},"activeModuleCount":{"type":"integer","minimum":0},"atmosphereIntegrityPercent":{"type":"number","minimum":0,"maximum":100},"contaminationPercent":{"type":"number","minimum":0,"maximum":100},"state":{"enum":["ACTIVE","INACTIVE","DEPRESSURIZED","LOST"]}}},
    "routeState":{"type":"object","additionalProperties":false,"required":["routeId","graphType","fromNodeId","toNodeId","state","functional"],"properties":{"routeId":{"type":"string","minLength":1},"graphType":{"type":"string","minLength":1},"fromNodeId":{"type":"string","minLength":1},"toNodeId":{"type":"string","minLength":1},"state":{"enum":["ACTIVE","SEVERED"]},"functional":{"type":"boolean"}}},
    "loadPathState":{"type":"object","additionalProperties":false,"required":["loadPathId","purpose","fromNodeId","toNodeId","state","continuous","valid"],"properties":{"loadPathId":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"fromNodeId":{"type":"string","minLength":1},"toNodeId":{"type":"string","minLength":1},"state":{"enum":["SURVIVING","SEVERED"]},"continuous":{"type":"boolean"},"valid":{"type":"boolean"}}},
    "edge":{"type":"object","additionalProperties":true,"required":["edgeId","from","to","edgeType","properties","state"],"properties":{"edgeId":{"type":"string"},"from":{"type":"string"},"to":{"type":"string"},"edgeType":{"type":"string"},"properties":{"type":"array"},"state":{"const":"ACTIVE"}}},
    "network":{"type":"object","additionalProperties":false,"required":["graphType","nodes","edges"],"properties":{"graphType":{"type":"string"},"nodes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"edges":{"type":"array","items":{"$ref":"#/$defs/edge"}}}},
    "recalculated":{"type":"object","additionalProperties":false,"required":["referenceMassTonnes","referenceVolumeM3","residualMassTonnes","residualVolumeM3","residualMassFraction","salvageableMassTonnes","installedModuleCount","operationalModuleCount","missingModuleCount","removedModuleCount","damagedModuleCount","destroyedModuleCount","severedRouteCount","readinessScore","conditionTags","powerCapacityPercent","coolingCapacityPercent","lifeSupportCapacityPercent","propulsionCapacityPercent","sensorsCapacityPercent","weaponsCapacityPercent","cargoCapacityPercent","componentCount","largestComponentNodeCount","largestComponentMassTonnes","largestCoherentComponentFraction","coherentVesselGraph"],"properties":{"referenceMassTonnes":{"type":"number","minimum":0},"referenceVolumeM3":{"type":"number","minimum":0},"residualMassTonnes":{"type":"number","minimum":0},"residualVolumeM3":{"type":"number","minimum":0},"residualMassFraction":{"type":"number","minimum":0,"maximum":1},"salvageableMassTonnes":{"type":"number","minimum":0},"installedModuleCount":{"type":"integer","minimum":0},"operationalModuleCount":{"type":"integer","minimum":0},"missingModuleCount":{"type":"integer","minimum":0},"removedModuleCount":{"type":"integer","minimum":0},"damagedModuleCount":{"type":"integer","minimum":0},"destroyedModuleCount":{"type":"integer","minimum":0},"severedRouteCount":{"type":"integer","minimum":0},"readinessScore":{"type":"number","minimum":0,"maximum":100},"conditionTags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"powerCapacityPercent":{"type":"number","minimum":0,"maximum":100},"coolingCapacityPercent":{"type":"number","minimum":0,"maximum":100},"lifeSupportCapacityPercent":{"type":"number","minimum":0,"maximum":100},"propulsionCapacityPercent":{"type":"number","minimum":0,"maximum":100},"sensorsCapacityPercent":{"type":"number","minimum":0,"maximum":100},"weaponsCapacityPercent":{"type":"number","minimum":0,"maximum":100},"cargoCapacityPercent":{"type":"number","minimum":0,"maximum":100},"componentCount":{"type":"integer","minimum":0},"largestComponentNodeCount":{"type":"integer","minimum":0},"largestComponentMassTonnes":{"type":"number","minimum":0},"largestCoherentComponentFraction":{"type":"number","minimum":0,"maximum":1},"coherentVesselGraph":{"type":"boolean"}}},
    "repair":{"type":"object","additionalProperties":false,"required":["repairId","type","targetId","description","deterministic"],"properties":{"repairId":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"targetId":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"deterministic":{"const":true}}},
    "validation":{"type":"object","additionalProperties":false,"required":["valid","violations","warnings","moduleStateCount","eventCount","repairCount"],"properties":{"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"moduleStateCount":{"type":"integer","minimum":0},"eventCount":{"type":"integer","minimum":0},"repairCount":{"type":"integer","minimum":0},"preRepairViolations":{"type":"array","items":{"type":"string"}}}}
  }
}