{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-module-graph.schema.json",
  "title":"Blacklight EXO Vessel Semantic Module Graph",
  "description":"VESSEL-03 graph connecting persistent physical modules while retaining vessel-wide distributed hardening rather than generating detachable armor modules.",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","vesselInstanceId","topology","validationMode","infrastructureNodes","modules","hardeningSummary","pressureZones","pressureZoneGraph","graphs","loadPaths","weaponHardpoints","sensorRequirements","repairLog","deferredSystems","validation"],
  "properties":{
    "recordType":{"const":"exoVesselModuleGraph"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-03"},
    "vesselInstanceId":{"type":"string","pattern":"^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "topology":{"type":"object","additionalProperties":false,"required":["key","weights","source","architecture"],"properties":{"key":{"enum":["MONOCOQUE","SPINE","CLUSTER","RING","HYBRID"]},"weights":{"type":"object"},"source":{"type":"string","minLength":1},"architecture":{"enum":["INTERNAL","EVA","HYBRID"]}}},
    "validationMode":{"enum":["REPAIR","STRICT"]},
    "infrastructureNodes":{"type":"array","minItems":9,"items":{"$ref":"#/$defs/infrastructureNode"}},
    "modules":{"type":"array","minItems":1,"items":{"$ref":"exo-vessel-module.schema.json"}},
    "hardeningSummary":{"$ref":"#/$defs/hardeningSummary"},
    "pressureZones":{"type":"array","items":{"$ref":"#/$defs/pressureZone"}},
    "pressureZoneGraph":{"$ref":"#/$defs/network"},
    "graphs":{"type":"object","additionalProperties":false,"required":["structural","power","cooling","data","atmosphere","access","magazineFeed","sensorDependency"],"properties":{"structural":{"$ref":"#/$defs/network"},"power":{"$ref":"#/$defs/network"},"cooling":{"$ref":"#/$defs/network"},"data":{"$ref":"#/$defs/network"},"atmosphere":{"$ref":"#/$defs/network"},"access":{"$ref":"#/$defs/network"},"magazineFeed":{"$ref":"#/$defs/network"},"sensorDependency":{"$ref":"#/$defs/network"}}},
    "loadPaths":{"type":"array","items":{"$ref":"#/$defs/loadPath"}},
    "weaponHardpoints":{"type":"array","items":{"$ref":"#/$defs/weaponHardpoint"}},
    "sensorRequirements":{"type":"array","items":{"$ref":"#/$defs/sensorRequirement"}},
    "repairLog":{"type":"array","items":{"$ref":"#/$defs/repair"}},
    "deferredSystems":{"type":"object","additionalProperties":false,"required":["voxelBounds","conditionApplication","trackAndCombatGeometry","weaponEngagementEnvelopes","localDamageResolution"],"properties":{"voxelBounds":{"const":"VESSEL-04"},"conditionApplication":{"const":"VESSEL-05"},"trackAndCombatGeometry":{"const":"VESSEL-06"},"weaponEngagementEnvelopes":{"const":"VESSEL-07"},"localDamageResolution":{"const":"VESSEL-08"}}},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "infrastructureNode":{"type":"object","additionalProperties":false,"required":["key","nodeType","label","properties","nodeId","massTonnes","volumeM3","state"],"properties":{"key":{"type":"string"},"nodeType":{"type":"string"},"label":{"type":"string"},"properties":{"type":"array","items":{"type":"string"}},"nodeId":{"type":"string"},"massTonnes":{"const":0},"volumeM3":{"const":0},"state":{"const":"ACTIVE"}}},
    "network":{"type":"object","additionalProperties":false,"required":["graphType","nodes","edges"],"properties":{"graphType":{"type":"string"},"nodes":{"type":"array","items":{"type":"string"}},"edges":{"type":"array","items":{"type":"object"}}}},
    "pressureZone":{"type":"object","additionalProperties":true,"required":["zoneId","key","label","inhabited","isolated","environment","moduleIds","evacuationTargets","state"]},
    "loadPath":{"type":"object","additionalProperties":true,"required":["loadPathId","fromNodeId","toNodeId","throughNodeIds","purpose","continuous","valid"]},
    "weaponHardpoint":{"type":"object","additionalProperties":true,"required":["hardpointId","moduleId","weaponFamily","facing","arc","recoilPathId","magazineModuleIds","supportModuleIds","coolingModuleIds","sensorModuleIds","fireControlModuleIds","valid"]},
    "sensorRequirement":{"type":"object","additionalProperties":true,"required":["requirementId","consumerModuleId","weaponFamily","requiredSensorTypes","minimumSensorChannels","minimumFireControlChannels","sourceModuleIds","fireControlModuleIds","valid"]},
    "repair":{"type":"object","additionalProperties":false,"required":["repairId","type","targetId","description","deterministic"],"properties":{"repairId":{"type":"string"},"type":{"type":"string"},"targetId":{"type":"string"},"description":{"type":"string"},"deterministic":{"const":true}}},
    "hardeningSummary":{"type":"object","additionalProperties":false,"required":["model","standaloneArmorModules","distributedMassTonnes","distributedVolumeM3","moduleCount","allocations","directionalArmor","directionalFields"],"properties":{"model":{"const":"DISTRIBUTED_HULL_AND_SYSTEM_HARDENING"},"standaloneArmorModules":{"const":false},"distributedMassTonnes":{"type":"number","minimum":0},"distributedVolumeM3":{"type":"number","minimum":0},"moduleCount":{"type":"integer","minimum":0},"allocations":{"type":"object"},"directionalArmor":{"type":"object"},"directionalFields":{"type":"object"}}},
    "validation":{"type":"object","additionalProperties":false,"required":["valid","violations","warnings","moduleMassTonnes","moduleVolumeM3","repairCount"],"properties":{"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"moduleMassTonnes":{"type":"number","minimum":0},"moduleVolumeM3":{"type":"number","minimum":0},"repairCount":{"type":"integer","minimum":0},"preRepairViolations":{"type":"array","items":{"type":"string"}}}}
  }
}
