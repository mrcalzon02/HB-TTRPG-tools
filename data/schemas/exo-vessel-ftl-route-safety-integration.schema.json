{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-route-safety-integration.schema.json",
  "title": "Black Light FTL Route Safety Integration Registry",
  "type": "object",
  "required": ["schemaVersion", "registryKey", "status", "designIntentSource", "familyMap", "routeArchetypes", "integrationRules", "api", "canonGuards"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "registryKey": {"const": "blacklight.ftl.route-safety-integration"},
    "status": {"enum": ["DERIVED", "PROPOSED", "MIXED"]},
    "designIntentSource": {
      "type": "object",
      "required": ["title", "documentId", "revisionId"],
      "properties": {
        "title": {"type": "string"},
        "documentId": {"type": "string"},
        "revisionId": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "upstream": {"type": "array", "items": {"type": "string"}},
        "runtime": {"type": "array", "items": {"type": "string"}},
        "supportingDocumentation": {"type": "array", "items": {"type": "string"}},
        "statusRule": {"type": "string"}
      }
    },
    "familyMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "routeArchetypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status", "environment", "uncertaintyBase", "requiredHazards"],
        "properties": {
          "status": {"enum": ["DERIVED", "PROPOSED"]},
          "environment": {
            "type": "object",
            "required": ["potentialMagnitude", "accelerationMagnitude", "tidalTensorNorm", "curvatureNorm", "massModelUncertainty", "hiddenMassProbability", "familyBoundaryHazard"],
            "additionalProperties": {"type": ["number", "string", "array", "object", "null"]}
          },
          "uncertaintyBase": {"type": "number", "minimum": 0},
          "requiredHazards": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "familyHazards": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "integrationRules": {"type": "array", "items": {"type": "string"}},
    "api": {
      "type": "object",
      "required": ["resolver", "statusValues"],
      "properties": {
        "resolver": {"const": "resolveGeneratedFTLRouteSafety"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "statusValues": {"type": "array", "items": {"enum": ["ADMISSIBLE", "MARGINAL", "REJECTED", "UNRESOLVED", "OUTSIDE_MODEL_VALIDITY", "CONFLICT"]}}
      }
    },
    "canonGuards": {"type": "array", "items": {"type": "string"}}
  }
}
