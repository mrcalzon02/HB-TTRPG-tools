{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-voxel-layout.schema.json",
  "title":"Blacklight EXO Vessel Voxel Layout",
  "description":"VESSEL-04 compressed sparse voxel layout preserving VESSEL-03 module identities while assigning topology, bounds, routes, surfaces, hardpoints, and clearance fields.",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","vesselInstanceId","topology","resolution","validationMode","grid","infrastructureAnchors","infrastructureBlocks","modulePlacements","occupiedBlocks","utilityRoutes","accessRoutes","evacuationRoutes","armorSurfaces","evaHardpoints","weaponHardpointPlacements","engineExhaustClearances","radiatorClearances","repairLog","deferredSystems","validation"],
  "properties":{
    "recordType":{"const":"exoVesselVoxelLayout"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-04"},
    "vesselInstanceId":{"type":"string","pattern":"^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "topology":{"type":"object","additionalProperties":false,"required":["key","source","policy"],"properties":{"key":{"enum":["MONOCOQUE","SPINE","CLUSTER","RING","HYBRID"]},"source":{"type":"string","minLength":1},"policy":{"type":"object"}}},
    "resolution":{"type":"object","additionalProperties":false,"required":["cellEdgeM","suggestedCellEdgeM","forcedCellEdgeM","adaptationIterations","maxEnvelopeCells","compressedSparse"],"properties":{"cellEdgeM":{"type":"number","exclusiveMinimum":0},"suggestedCellEdgeM":{"type":"number","exclusiveMinimum":0},"forcedCellEdgeM":{"type":["number","null"],"exclusiveMinimum":0},"adaptationIterations":{"type":"integer","minimum":0},"maxEnvelopeCells":{"type":"integer","minimum":1},"compressedSparse":{"const":true}}},
    "validationMode":{"enum":["REPAIR","STRICT"]},
    "grid":{"$ref":"#/$defs/grid"},
    "infrastructureAnchors":{"type":"array","minItems":9,"items":{"$ref":"#/$defs/anchor"}},
    "infrastructureBlocks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/block"}},
    "modulePlacements":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/placement"}},
    "occupiedBlocks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/block"}},
    "utilityRoutes":{"type":"object","additionalProperties":false,"required":["structural","power","cooling","data","atmosphere","access","magazineFeed","sensorDependency"],"properties":{"structural":{"type":"array","items":{"$ref":"#/$defs/route"}},"power":{"type":"array","items":{"$ref":"#/$defs/route"}},"cooling":{"type":"array","items":{"$ref":"#/$defs/route"}},"data":{"type":"array","items":{"$ref":"#/$defs/route"}},"atmosphere":{"type":"array","items":{"$ref":"#/$defs/route"}},"access":{"type":"array","items":{"$ref":"#/$defs/route"}},"magazineFeed":{"type":"array","items":{"$ref":"#/$defs/route"}},"sensorDependency":{"type":"array","items":{"$ref":"#/$defs/route"}}}},
    "accessRoutes":{"type":"array","items":{"$ref":"#/$defs/route"}},
    "evacuationRoutes":{"type":"array","items":{"type":"object"}},
    "armorSurfaces":{"type":"array","items":{"type":"object"}},
    "evaHardpoints":{"type":"array","items":{"type":"object"}},
    "weaponHardpointPlacements":{"type":"array","items":{"type":"object"}},
    "engineExhaustClearances":{"type":"array","items":{"$ref":"#/$defs/clearance"}},
    "radiatorClearances":{"type":"array","items":{"$ref":"#/$defs/clearance"}},
    "repairLog":{"type":"array","items":{"type":"object"}},
    "deferredSystems":{"type":"object","additionalProperties":false,"required":["conditionApplication","trackAndCombatGeometry","weaponEngagementEnvelopes","localDamageResolution"],"properties":{"conditionApplication":{"const":"VESSEL-05"},"trackAndCombatGeometry":{"const":"VESSEL-06"},"weaponEngagementEnvelopes":{"const":"VESSEL-07"},"localDamageResolution":{"const":"VESSEL-08"}}},
    "validation":{"type":"object","additionalProperties":true,"required":["valid","violations","warnings","placedModuleCount","occupiedBlockCount","envelopeCellCount","repairCount"],"properties":{"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"placedModuleCount":{"type":"integer","minimum":0},"occupiedBlockCount":{"type":"integer","minimum":0},"envelopeCellCount":{"type":"integer","minimum":1},"repairCount":{"type":"integer","minimum":0}}}
  },
  "$defs":{
    "point":{"type":"object","additionalProperties":false,"required":["x","y","z"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"}}},
    "size":{"type":"object","additionalProperties":false,"required":["x","y","z"],"properties":{"x":{"type":"integer","minimum":1},"y":{"type":"integer","minimum":1},"z":{"type":"integer","minimum":1}}},
    "bounds":{"type":"object","additionalProperties":false,"required":["min","max","size","cellEdgeM","orientation","topologyLane"],"properties":{"min":{"$ref":"#/$defs/point"},"max":{"$ref":"#/$defs/point"},"size":{"$ref":"#/$defs/size"},"cellEdgeM":{"type":"number","exclusiveMinimum":0},"orientation":{"const":"X_FORWARD"},"topologyLane":{"type":"integer","minimum":0}}},
    "grid":{"type":"object","additionalProperties":false,"required":["vesselInstanceId","size","cellEdgeM","envelopeCellCount","physicalSizeM","axisConvention"],"properties":{"vesselInstanceId":{"type":"string"},"size":{"$ref":"#/$defs/size"},"cellEdgeM":{"type":"number","exclusiveMinimum":0},"envelopeCellCount":{"type":"integer","minimum":1},"physicalSizeM":{"$ref":"#/$defs/point"},"axisConvention":{"type":"object"}}},
    "anchor":{"type":"object","additionalProperties":false,"required":["nodeId","nodeType","label","point","voxelType","topology"],"properties":{"nodeId":{"type":"string"},"nodeType":{"type":"string"},"label":{"type":"string"},"point":{"$ref":"#/$defs/point"},"voxelType":{"type":"string"},"topology":{"enum":["MONOCOQUE","SPINE","CLUSTER","RING","HYBRID"]}}},
    "block":{"type":"object","additionalProperties":true,"required":["blockId","voxelType","bounds"],"properties":{"blockId":{"type":"string"},"moduleId":{"type":"string"},"voxelType":{"type":"string"},"bounds":{"type":"object"}}},
    "placement":{"type":"object","additionalProperties":false,"required":["placementId","moduleId","semanticType","envelope","pressureZoneId","bounds","requiredCells","capacityCells","representedVolumeM3","actualModuleVolumeM3","packingUtilization","voxelType","color"],"properties":{"placementId":{"type":"string"},"moduleId":{"type":"string","pattern":"^module-[a-z0-9][a-z0-9-]{5,95}$"},"semanticType":{"type":"string"},"envelope":{"enum":["INTERNAL","EVA"]},"pressureZoneId":{"type":["string","null"]},"bounds":{"$ref":"#/$defs/bounds"},"requiredCells":{"type":"integer","minimum":1},"capacityCells":{"type":"integer","minimum":1},"representedVolumeM3":{"type":"number","minimum":0},"actualModuleVolumeM3":{"type":"number","minimum":0},"packingUtilization":{"type":"number","minimum":0,"maximum":1},"voxelType":{"type":"string"},"color":{"type":"string"}}},
    "route":{"type":"object","additionalProperties":false,"required":["routeId","sourceEdgeId","graphType","fromNodeId","toNodeId","points","voxelType","valid"],"properties":{"routeId":{"type":"string"},"sourceEdgeId":{"type":"string"},"graphType":{"type":"string"},"fromNodeId":{"type":"string"},"toNodeId":{"type":"string"},"points":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/point"}},"voxelType":{"type":"string"},"valid":{"type":"boolean"}}},
    "clearance":{"type":"object","additionalProperties":false,"required":["clearanceId","moduleId","direction","points","clear","voxelType"],"properties":{"clearanceId":{"type":"string"},"moduleId":{"type":"string"},"direction":{"type":"string"},"points":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/point"}},"clear":{"type":"boolean"},"voxelType":{"type":"string"}}}
  }
}