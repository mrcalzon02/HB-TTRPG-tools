{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-first-blocker-presentation.schema.json",
  "title": "Black Light FTL First-Blocker Presentation Model",
  "description": "Presentation-only contract for rendering family-specific physical route interval certificates, provenance-bearing topology-hazard applicability, and authorized conservative blocker envelopes without recomputing or replacing underlying safety evidence.",
  "type": "object",
  "required": ["schemaVersion", "status", "family", "corridor", "firstBlocker", "provenance", "canonSafeguards"],
  "properties": {
    "schemaVersion": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "status": {"enum": ["ADMISSIBLE", "MARGINAL", "REJECTED", "UNRESOLVED", "OUTSIDE_MODEL_VALIDITY", "CONFLICT"]},
    "family": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]},
    "corridor": {
      "type": "object",
      "required": ["conjunctive", "segments"],
      "properties": {
        "conjunctive": {"const": true},
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "fractionStart", "fractionEnd", "status", "blocking", "reasons"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "fractionStart": {"type": "number", "minimum": 0, "maximum": 1},
              "fractionEnd": {"type": "number", "minimum": 0, "maximum": 1},
              "status": {"type": "string"},
              "blocking": {"type": "boolean"},
              "reasons": {"type": "array", "items": {"type": "string"}},
              "gravityEfficiency": {"type": ["number", "null"]},
              "calculationEfficiency": {"type": ["number", "null"]},
              "interventionReachable": {"type": ["boolean", "null"]},
              "environment": {"type": ["object", "null"]},
              "uncertainty": {"type": ["object", "null"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "firstBlocker": {
      "type": ["object", "null"],
      "properties": {
        "segmentIndex": {"type": "integer", "minimum": 0},
        "fractionStart": {"type": "number", "minimum": 0, "maximum": 1},
        "fractionEnd": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"type": "string"},
        "distanceM": {"type": ["number", "null"], "minimum": 0},
        "timeS": {"type": ["number", "null"], "minimum": 0},
        "nominalDistanceM": {"type": ["number", "null"], "minimum": 0},
        "nominalTimeS": {"type": ["number", "null"], "minimum": 0},
        "interventionReachable": {"type": ["boolean", "null"]},
        "conservativeEnvelope": {
          "type": ["object", "null"],
          "properties": {
            "source": {"type": ["string", "null"]},
            "hazardKey": {"type": ["string", "null"]},
            "applicableToCertifiedBlocker": {"type": "boolean"},
            "applicabilityStatus": {"type": ["string", "null"]},
            "applicabilityRelationship": {"type": ["string", "null"]},
            "applicabilityRecordId": {"type": ["string", "null"]},
            "applicabilityScopeType": {"type": ["string", "null"]},
            "applicabilitySourceTitle": {"type": ["string", "null"]},
            "applicabilitySourceDocumentId": {"type": ["string", "null"]},
            "applicabilitySourceRevisionId": {"type": ["string", "null"]},
            "familyMatch": {"type": "boolean"},
            "nominalBlockingFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "nominalTopologyBoundaryFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "earliestPlausibleTopologyBoundaryFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "boundaryFractionSigmaUpperBound": {"type": ["number", "null"], "minimum": 0},
            "effectiveBlockingFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "nominalDistanceM": {"type": ["number", "null"], "minimum": 0},
            "effectiveDistanceM": {"type": ["number", "null"], "minimum": 0},
            "nominalTimeS": {"type": ["number", "null"], "minimum": 0},
            "effectiveTimeS": {"type": ["number", "null"], "minimum": 0},
            "interventionReachable": {"type": ["boolean", "null"]},
            "reason": {"type": ["string", "null"]},
            "provenance": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "presentationRules": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "canonSafeguards": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
