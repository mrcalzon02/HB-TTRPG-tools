{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-module.schema.json",
  "title": "Blacklight EXO Vessel Semantic Module",
  "description": "Persistent VESSEL-03 physical module identity. VESSEL-04 assigns integer-cell voxel bounds without replacing or renaming the module.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType", "schemaVersion", "moduleId", "vesselInstanceId", "subsystemKey", "label", "semanticType", "envelope", "pressureZoneId", "criticality", "serviceMode", "massTonnes", "volumeM3", "technology", "attachment", "requirements", "dependencies", "hazards", "functions", "state", "voxelBounds", "provenance", "extensions"
  ],
  "properties": {
    "recordType": {"const": "exoVesselModule"},
    "schemaVersion": {"const": "1.0.0"},
    "moduleId": {"type": "string", "pattern": "^module-[a-z0-9][a-z0-9-]{5,95}$"},
    "vesselInstanceId": {"type": "string", "pattern": "^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "subsystemKey": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "semanticType": {"type": "string", "minLength": 1},
    "envelope": {"enum": ["INTERNAL", "EVA"]},
    "pressureZoneId": {"type": ["string", "null"]},
    "criticality": {"enum": ["CRITICAL", "PROTECTIVE", "MISSION", "COMBAT", "RESERVE"]},
    "serviceMode": {"enum": ["INTERNAL_CORRIDOR", "EVA_OR_REMOTE"]},
    "massTonnes": {"type": "number", "minimum": 0},
    "volumeM3": {"type": "number", "minimum": 0},
    "technology": {
      "type": "object", "additionalProperties": false, "required": ["principalBand", "variant", "offset", "heritageBand"],
      "properties": {
        "principalBand": {"enum": ["T-1", "P0", "P1", "P2", "P3", "P4", "P5", "P6"]},
        "variant": {"enum": ["LEGACY", "STANDARD", "REFINED", "ADVANCED", "PROTOTYPE"]},
        "offset": {"type": "number", "minimum": -0.3, "maximum": 0.3},
        "heritageBand": {"enum": ["T-1", "P0", "P1", "P2", "P3", "P4", "P5", "P6"]}
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false, "required": ["parentId", "requiredProperty", "parentProperties", "valid"],
      "properties": {
        "parentId": {"type": "string", "minLength": 1},
        "requiredProperty": {"enum": ["ATMOSPHERE_MANIFOLD", "VACUUM_EXPOSED"]},
        "parentProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "valid": {"type": "boolean"}
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false, "required": ["power", "cooling", "data", "atmosphere", "access", "crewDependent"],
      "properties": {"power": {"type": "boolean"}, "cooling": {"type": "boolean"}, "data": {"type": "boolean"}, "atmosphere": {"type": "boolean"}, "access": {"type": "boolean"}, "crewDependent": {"type": "boolean"}}
    },
    "dependencies": {
      "type": "object", "additionalProperties": false, "required": ["structural", "power", "cooling", "data", "atmosphere", "access", "magazine", "sensors"],
      "properties": {
        "structural": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "power": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cooling": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "data": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "atmosphere": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "access": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "magazine": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sensors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "hazards": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state": {
      "type": "object", "additionalProperties": false, "required": ["constructionPercent", "damagePercent", "salvageRemovalPercent", "operational", "applicationStatus"],
      "properties": {
        "constructionPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "damagePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "salvageRemovalPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "operational": {"type": "boolean"},
        "applicationStatus": {"enum": ["INTACT_REFERENCE", "CONDITION_APPLIED", "DAMAGED", "REMOVED", "DESTROYED"]}
      }
    },
    "voxelBounds": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/voxelBounds"}]},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["sourceEngineeringKey", "sourceEngineeringLabel", "splitIndex", "splitCount", "generatorId", "generatorVersion"],
      "properties": {
        "sourceEngineeringKey": {"type": "string", "minLength": 1}, "sourceEngineeringLabel": {"type": "string", "minLength": 1},
        "splitIndex": {"type": "integer", "minimum": 0}, "splitCount": {"type": "integer", "minimum": 1},
        "generatorId": {"const": "blacklight-exo-vessel-module-graph-generator"}, "generatorVersion": {"const": "1.0.0"}
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}},
    "size": {"type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {"x": {"type": "integer", "minimum": 1}, "y": {"type": "integer", "minimum": 1}, "z": {"type": "integer", "minimum": 1}}},
    "voxelBounds": {
      "type": "object", "additionalProperties": false, "required": ["min", "max", "size", "cellEdgeM", "orientation", "topologyLane"],
      "properties": {
        "min": {"$ref": "#/$defs/point"}, "max": {"$ref": "#/$defs/point"}, "size": {"$ref": "#/$defs/size"},
        "cellEdgeM": {"type": "number", "exclusiveMinimum": 0}, "orientation": {"const": "X_FORWARD"}, "topologyLane": {"type": "integer", "minimum": 0}
      }
    }
  }
}