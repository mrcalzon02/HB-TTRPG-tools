{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-installation-archaeology.schema.json",
  "title": "Black Light FTL Installation Archaeology Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryKey",
    "authority",
    "archaeologyModel",
    "compartmentModel",
    "evidenceLifecycle",
    "mathematics",
    "inspectionProgram",
    "equipmentClasses",
    "currentArNockCase",
    "api",
    "provenance",
    "canonGuards"
  ],
  "properties": {
    "schemaVersion": {"type": "string"},
    "registryKey": {"const": "blacklight.ftl.installation-archaeology"},
    "authority": {"type": "object", "required": ["status", "scope", "sourceOrder", "designSource"]},
    "archaeologyModel": {"type": "object", "required": ["principles", "evidenceDomains", "damageStates", "accessStates"]},
    "compartmentModel": {"type": "object", "required": ["nodeFields", "edgeFields", "installationGraphRule", "unknownVolumeRule"]},
    "evidenceLifecycle": {"type": "object", "required": ["states", "promotionRule", "contaminationRule", "destructiveTestRule"]},
    "mathematics": {"type": "object", "required": ["compartmentEvidenceWeight", "dependencyCentrality", "geometryConsistency", "damageAdjustedAbsence", "informationGain", "familyEvidenceExport"]},
    "inspectionProgram": {"type": "array", "minItems": 6},
    "equipmentClasses": {"type": "array", "minItems": 8},
    "currentArNockCase": {"type": "object", "required": ["state", "familyAssignment", "knownInstallationFacts", "prioritySurveyProgram"]},
    "api": {"type": "object", "required": ["resolver", "inputs", "outputs", "authorityModes"]},
    "provenance": {"type": "object", "required": ["sourceGraph", "designDocumentId", "designDocumentRevision"]},
    "canonGuards": {"type": "array", "minItems": 10}
  },
  "additionalProperties": true
}
