{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-ftl-metric-technical-volume.schema.json",
  "title": "Black Light Metric Compression Technical Volume",
  "type": "object",
  "required": ["schema_version","family","authority","mathematics","path_progression","machinery","operation","maintenance","signatures","failures","scaling","technology_basis_translation","generator_contract","provenance"],
  "properties": {
    "schema_version": {"type":"string"},
    "family": {"const":"metric-envelope"},
    "authority": {
      "type":"object",
      "required":["status","primary","legacy_design_source"],
      "properties": {
        "status":{"enum":["CONFIRMED","DERIVED","PROPOSED","MIXED"]},
        "primary":{"type":"string"},
        "legacy_design_source":{"type":"object","required":["title","file_id","revision_id"],"properties":{"title":{"type":"string"},"file_id":{"type":"string"},"revision_id":{"type":"string"}}}
      }
    },
    "mathematics": {
      "type":"object",
      "required":["status","state","effective_distance","route_objective","gravity_burden","structural_margin","safety_horizon"],
      "additionalProperties": true
    },
    "path_progression": {
      "type":"array","minItems":7,"maxItems":7,
      "items":{"type":"object","required":["path","implementation","mathematical_capability","physical_enablers","changed_limits","operational_result","status"],"properties":{"path":{"enum":["P0","P1","P2","P3","P4","P5","P6"]},"implementation":{"type":"string"},"mathematical_capability":{"type":"string"},"physical_enablers":{"type":"array","items":{"type":"string"}},"changed_limits":{"type":"array","items":{"type":"string"}},"operational_result":{"type":"string"},"status":{"enum":["CONFIRMED","DERIVED","PROPOSED","MIXED"]}}}
    },
    "machinery":{"type":"object","required":["blocks","layout_invariants"],"additionalProperties":true},
    "operation":{"type":"object","additionalProperties":true},
    "maintenance":{"type":"object","additionalProperties":true},
    "signatures":{"type":"object","additionalProperties":true},
    "failures":{"type":"object","additionalProperties":true},
    "scaling":{"type":"object","additionalProperties":true},
    "technology_basis_translation":{"type":"object","additionalProperties":true},
    "generator_contract":{"type":"object","required":["inputs","outputs","hard_guards"],"additionalProperties":true},
    "provenance":{"type":"object","required":["canon_rule","field_status_required"],"additionalProperties":true}
  },
  "additionalProperties": false
}
