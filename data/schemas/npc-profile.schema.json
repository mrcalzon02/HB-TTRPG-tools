{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/npc-profile.schema.json",
  "title": "Universal NPC Profile",
  "description": "Canonical setting-neutral profile produced or edited by the Universal NPC Profile Generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileType",
    "schemaVersion",
    "profileId",
    "revision",
    "createdAt",
    "updatedAt",
    "generator",
    "archetype",
    "identity",
    "sections",
    "locks",
    "diagnostics",
    "provenance"
  ],
  "properties": {
    "profileType": {
      "const": "npcProfile"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^npc-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "$ref": "#/$defs/generatorReceipt"
    },
    "archetype": {
      "$ref": "#/$defs/archetypeReference"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "sections": {
      "$ref": "#/$defs/profileSections"
    },
    "locks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(identity|sections|archetype)(/.*)?$"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "generatorReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatorId",
        "generatorVersion",
        "packId",
        "packVersion",
        "seed",
        "mode"
      ],
      "properties": {
        "generatorId": {
          "const": "universal-npc-profile-generator"
        },
        "generatorVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "packVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "manual",
            "imported"
          ]
        },
        "rerollCounters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "archetypeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "subtypeId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "ancestryId",
        "ageBand",
        "pronouns",
        "languages"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "givenName": {
          "type": [
            "string",
            "null"
          ]
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "titles": {
          "$ref": "#/$defs/stringList"
        },
        "pronouns": {
          "type": "string",
          "minLength": 1
        },
        "gender": {
          "type": [
            "string",
            "null"
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ageBand": {
          "enum": [
            "child",
            "adolescent",
            "adult",
            "middle-aged",
            "elderly",
            "ageless",
            "unknown"
          ]
        },
        "ancestryId": {
          "type": "string",
          "minLength": 1
        },
        "cultureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "homeland": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentLocation": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "sectionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "present",
            "none",
            "unknown",
            "not-applicable"
          ]
        },
        "data": {
          "type": "object"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "substituteSection": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "sourceIds": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "data"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not-applicable"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "profileSections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance",
        "mechanics",
        "socialEconomic",
        "residence",
        "workContext",
        "familyHousehold",
        "personality",
        "motivations",
        "background",
        "affiliationsRelationships",
        "possessionsResources",
        "secretsProblemsHooks"
      ],
      "properties": {
        "appearance": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "mechanics": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "socialEconomic": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "residence": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "workContext": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "familyHousehold": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "personality": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "motivations": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "background": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "affiliationsRelationships": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "possessionsResources": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "secretsProblemsHooks": {
          "$ref": "#/$defs/sectionEnvelope"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sectionEnvelope"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdBy",
        "sourcePackIds",
        "sourceEntryIds"
      ],
      "properties": {
        "createdBy": {
          "enum": [
            "generator",
            "user",
            "import",
            "migration"
          ]
        },
        "sourcePackIds": {
          "$ref": "#/$defs/stringList"
        },
        "sourceEntryIds": {
          "$ref": "#/$defs/stringList"
        },
        "migratedFromSchema": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}