{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-technology-basis.schema.json",
  "title":"Blacklight EXO Vessel Operative Technology Basis",
  "description":"Species-, environment-, society-, and manufacturer-derived technological basis. Utility routes preserve invariant end effects while carriers, controls, actuators, atmosphere machinery, thermal methods, seals, materials, installation environments, tolerances, failure modes, and interoperability may be fundamentally nonhuman.",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","basisId","manufacturerId","speciesId","organizationId","primaryBasisKey","primaryLabel","secondaryBasisKey","secondaryLabel","hybridizationFraction","summary","origin","routeStandards","operativeTheories","materials","standards","failureModes","interoperability","provenance","validation"],
  "properties":{
    "recordType":{"const":"exoVesselTechnologyBasis"},
    "schemaVersion":{"const":"1.0.0"},
    "basisId":{"type":"string","pattern":"^techbasis-[a-z0-9][a-z0-9-]{5,120}$"},
    "manufacturerId":{"type":"string","pattern":"^mfr-[a-z0-9][a-z0-9-]{5,95}$"},
    "speciesId":{"type":"string","pattern":"^species-[a-z0-9][a-z0-9-]{5,95}$"},
