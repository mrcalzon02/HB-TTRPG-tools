  },
  "$defs":{
    "basisKey":{"enum":["TERRESTRIAL_ELECTROMECHANICAL","AQUATIC_ELECTROCHEMICAL_HYDRAULIC","CRYOGENIC_AMMONIA_HALOCARBON","GAS_GIANT_FLUIDIC_ELECTROSTATIC","BIOLOGICAL_SYMBIOTIC","MINERAL_PIEZOELECTRIC_PHOTONIC","FIELD_MEDIATED_POSTMATERIAL"]},
    "routeStandard":{"type":"object","additionalProperties":false,"required":["routeKey","endEffect","invariantRouteRequirement","carrier","interface","tolerance","secondaryInfluence"],"properties":{"routeKey":{"enum":["structural","power","cooling","data","atmosphere","access"]},"endEffect":{"type":"string","minLength":1},"invariantRouteRequirement":{"const":true},"carrier":{"type":"string","minLength":1},"interface":{"type":"string","minLength":1},"tolerance":{"type":"string","minLength":1},"secondaryInfluence":{"type":["string","null"]}}},
    "validation":{"type":"object","additionalProperties":false,"required":["valid","violations"],"properties":{"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}}}}
  }
}
