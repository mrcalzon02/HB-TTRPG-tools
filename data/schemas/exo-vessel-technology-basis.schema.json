    "secondaryLabel":{"type":"string","minLength":1},
    "hybridizationFraction":{"type":"number","minimum":0,"maximum":0.42},
    "summary":{"type":"string","minLength":1},
    "origin":{"type":"object","additionalProperties":false,"required":["sourceSpecies","sourceOrganization","sourceEnvironment","sourceChemistry","sourceBodyPlan","civilizationTechnology","inferenceText","explicitOverride"],"properties":{"sourceSpecies":{"type":"string","minLength":1},"sourceOrganization":{"type":"string","minLength":1},"sourceEnvironment":{"type":["string","null"]},"sourceChemistry":{"type":["string","null"]},"sourceBodyPlan":{"type":["string","null"]},"civilizationTechnology":{"type":["string","null"]},"inferenceText":{"type":"string","minLength":1},"explicitOverride":{"type":"boolean"}}},
    "routeStandards":{"type":"object","additionalProperties":false,"required":["structural","power","cooling","data","atmosphere","access"],"properties":{"structural":{"$ref":"#/$defs/routeStandard"},"power":{"$ref":"#/$defs/routeStandard"},"cooling":{"$ref":"#/$defs/routeStandard"},"data":{"$ref":"#/$defs/routeStandard"},"atmosphere":{"$ref":"#/$defs/routeStandard"},"access":{"$ref":"#/$defs/routeStandard"}}},
    "operativeTheories":{"type":"object","additionalProperties":false,"required":["energyGeneration","energyDistribution","actuation","control","atmosphereRegulation","thermalManagement","sensing","sealing","joining","insulation"],"properties":{"energyGeneration":{"type":"string","minLength":1},"energyDistribution":{"type":"string","minLength":1},"actuation":{"type":"string","minLength":1},"control":{"type":"string","minLength":1},"atmosphereRegulation":{"type":"string","minLength":1},"thermalManagement":{"type":"string","minLength":1},"sensing":{"type":"string","minLength":1},"sealing":{"type":"string","minLength":1},"joining":{"type":"string","minLength":1},"insulation":{"type":"string","minLength":1}}},
    "materials":{"type":"object","additionalProperties":false,"required":["preferred","sealants","forbidden"],"properties":{"preferred":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"sealants":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"forbidden":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "standards":{"type":"object","additionalProperties":false,"required":["connectorFamily","controlReference","energyReference","boundaryPractice","joiningPractice","maintenanceEnvironment","commissioningEnvironment","clearanceMultiplier","orientationSensitivity","pressureCompatibility","immersionCompatibility"],"properties":{"connectorFamily":{"type":"string","minLength":1},"controlReference":{"type":"string","minLength":1},"energyReference":{"type":"string","minLength":1},"boundaryPractice":{"type":"string","minLength":1},"joiningPractice":{"type":"string","minLength":1},"maintenanceEnvironment":{"type":"string","minLength":1},"commissioningEnvironment":{"type":"string","minLength":1},"clearanceMultiplier":{"type":"number","exclusiveMinimum":0},"orientationSensitivity":{"type":"string","minLength":1},"pressureCompatibility":{"type":"string","minLength":1},"immersionCompatibility":{"type":"string","minLength":1}}},
    "failureModes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "interoperability":{"type":"object","additionalProperties":false,"required":["humanInteroperability","adapterPolicy","conversionInterfaces","nativeCompatibilityTags","sameEndEffectsDoNotImplyDirectCompatibility"],"properties":{"humanInteroperability":{"enum":["DIRECT","ADAPTER_REQUIRED","HOSTILE_WITHOUT_CONVERSION"]},"adapterPolicy":{"type":"string","minLength":1},"conversionInterfaces":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"nativeCompatibilityTags":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},"sameEndEffectsDoNotImplyDirectCompatibility":{"const":true}}},
    "moduleApplication":{"type":"object","additionalProperties":false,"required":["schemaVersion","moduleCount","routeInterfaceCount","pressureZoneCount","methodologySpecificMassVolumeRecalculationStatus","distinctEndEffects","distinctOperativeTheories"],"properties":{"schemaVersion":{"const":"1.0.0"},"moduleCount":{"type":"integer","minimum":1},"routeInterfaceCount":{"type":"integer","minimum":1},"pressureZoneCount":{"type":"integer","minimum":0},"methodologySpecificMassVolumeRecalculationStatus":{"const":"DEFERRED_CLOSED_REFERENCE_RETAINED"},"distinctEndEffects":{"type":"integer","minimum":1},"distinctOperativeTheories":{"type":"integer","minimum":1}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["sourceSpeciesSeed","sourceOrganizationSeed","sourceManufacturerSeed","generatorId","generatorVersion"],"properties":{"sourceSpeciesSeed":{"type":"string","minLength":1},"sourceOrganizationSeed":{"type":"string","minLength":1},"sourceManufacturerSeed":{"type":"string","minLength":1},"generatorId":{"const":"blacklight-exo-vessel-technology-basis-generator"},"generatorVersion":{"const":"1.0.0"}}},
