{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-gameplay.schema.json",
  "title":"Blacklight EXO Vessel RPG Statistics and Action Economy",
  "description":"VESSEL-09 source-traceable normalized vessel statistics, action availability, timing, resources, and one shared percentile authority for simplified and detailed play.",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","vesselInstanceId","gameplaySeed","validationMode","referenceAuthority","normalization","statistics","resources","actions","simplifiedResolution","detailedResolution","resolverCompatibility","repairLog","deferredSystems","validation"],
  "properties":{
    "recordType":{"const":"exoVesselGameplayModel"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-09"},
    "vesselInstanceId":{"type":"string","pattern":"^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "gameplaySeed":{"type":"string","minLength":1},
    "validationMode":{"enum":["REPAIR","STRICT"]},
    "referenceAuthority":{"type":"object","additionalProperties":false,"required":["engineeringLedger","moduleGraph","conditionHistory","combatGeometry","weaponEngagement","combatResolution"],"properties":{"engineeringLedger":{"const":"VESSEL-02_PHYSICAL_PERFORMANCE_AND_RESOURCE_AUTHORITY"},"moduleGraph":{"const":"VESSEL-03_INSTALLED_SYSTEM_AND_ROUTE_AUTHORITY"},"conditionHistory":{"const":"VESSEL-05_SURVIVING_GRAPH_AND_RESOURCE_AUTHORITY"},"combatGeometry":{"const":"VESSEL-06_TRACK_AND_FIRE_CONTROL_AUTHORITY"},"weaponEngagement":{"const":"VESSEL-07_WEAPON_FAMILY_AND_ENVELOPE_AUTHORITY"},"combatResolution":{"const":"VESSEL-08_POST_IMPACT_STATE_AUTHORITY"}}},
    "normalization":{"type":"object","additionalProperties":false,"required":["minimum","maximum","bands","sourcePolicy","probabilityAuthority"],"properties":{"minimum":{"const":0},"maximum":{"const":100},"bands":{"type":"array","minItems":6,"items":{"type":"object"}},"sourcePolicy":{"const":"TRACEABLE_WEIGHTED_SOURCES"},"probabilityAuthority":{"const":"SHARED_PERCENTILE"}}},
    "statistics":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/statistic"}},
    "resources":{"$ref":"#/$defs/resources"},
    "actions":{"type":"array","minItems":15,"items":{"$ref":"#/$defs/action"}},
    "simplifiedResolution":{"$ref":"#/$defs/resolutionMode"},
    "detailedResolution":{"$ref":"#/$defs/resolutionMode"},
    "resolverCompatibility":{"type":"object","additionalProperties":false,"required":["sameProbabilityAuthority","sameRollForSameSeed","sameOutcomeBandForSameRoll","presentationMayDiffer"],"properties":{"sameProbabilityAuthority":{"const":true},"sameRollForSameSeed":{"const":true},"sameOutcomeBandForSameRoll":{"const":true},"presentationMayDiffer":{"const":true}}},
    "repairLog":{"type":"array","items":{"$ref":"#/$defs/repair"}},
    "deferredSystems":{"type":"object","additionalProperties":false,"required":["integratedUiAndCampaignPersistence","validationAndBalanceMatrix"],"properties":{"integratedUiAndCampaignPersistence":{"const":"VESSEL-10"},"validationAndBalanceMatrix":{"const":"VESSEL-11"}}},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "source":{"type":"object","additionalProperties":false,"required":["path","value","weight","rationale"],"properties":{"path":{"type":"string","minLength":1},"value":{"type":"number"},"weight":{"type":"number","minimum":0},"rationale":{"type":"string","minLength":1}}},
    "modifier":{"type":"object","additionalProperties":true,"required":["value"],"properties":{"value":{"type":"number"}}},
    "statistic":{"type":"object","additionalProperties":false,"required":["key","label","domain","description","value","band","available","sourceLinks","modifiers"],"properties":{"key":{"enum":["MOBILITY","NAVIGATION","SENSORS","TARGETING","OFFENSE","DEFENSE","ENGINEERING","DAMAGE_CONTROL","ENDURANCE","COMMAND"]},"label":{"type":"string","minLength":1},"domain":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"value":{"type":"number","minimum":0,"maximum":100},"band":{"enum":["UNAVAILABLE","CRITICAL","LIMITED","CAPABLE","STRONG","EXCEPTIONAL"]},"available":{"type":"boolean"},"sourceLinks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},"modifiers":{"type":"array","items":{"$ref":"#/$defs/modifier"}}}},
    "pool":{"type":"object","additionalProperties":false,"required":["key","label","unit","maximum","current","refreshPerTacticalRound","sourceLinks"],"properties":{"key":{"enum":["command","reaction","power","thermal","combatDeltaV","ammunition","damageControlTeam","parts"]},"label":{"type":"string","minLength":1},"unit":{"type":"string","minLength":1},"maximum":{"type":"number","minimum":0},"current":{"type":"number","minimum":0},"refreshPerTacticalRound":{"type":"number","minimum":0},"sourceLinks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}}},
    "clock":{"type":"object","additionalProperties":false,"required":["key","label","seconds","sourcePath"],"properties":{"key":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"seconds":{"type":"number","minimum":0},"sourcePath":{"type":"string","minLength":1}}},
    "resources":{"type":"object","additionalProperties":false,"required":["tacticalRoundSeconds","initiativeWindowSeconds","pools","clocks"],"properties":{"tacticalRoundSeconds":{"const":6},"initiativeWindowSeconds":{"const":1},"pools":{"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/pool"}},"clocks":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/clock"}}}},
    "cost":{"type":"object","additionalProperties":false,"required":["resourceKey","amount"],"properties":{"resourceKey":{"enum":["command","reaction","power","thermal","combatDeltaV","ammunition","damageControlTeam","parts"]},"amount":{"type":"number","minimum":0}}},
    "action":{"type":"object","additionalProperties":false,"required":["actionId","category","label","description","statKey","tempoKey","durationSeconds","durationRounds","baseDifficultyPercent","successProbabilityPercent","available","availabilityReasons","resourceCosts","prerequisites","sourceLinks","outcomeAuthority"],"properties":{"actionId":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},"category":{"enum":["NAVIGATION","SENSOR_TARGETING","OFFENSIVE","DEFENSIVE","ENGINEERING_DAMAGE_CONTROL"]},"label":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"statKey":{"enum":["MOBILITY","NAVIGATION","SENSORS","TARGETING","OFFENSE","DEFENSE","ENGINEERING","DAMAGE_CONTROL","ENDURANCE","COMMAND"]},"tempoKey":{"enum":["REACTION","TACTICAL","OPERATIONAL","DAMAGE_CONTROL","WATCH"]},"durationSeconds":{"type":"number","minimum":0},"durationRounds":{"type":"number","minimum":0},"baseDifficultyPercent":{"type":"number","minimum":0,"maximum":100},"successProbabilityPercent":{"type":"number","minimum":0,"maximum":100},"available":{"type":"boolean"},"availabilityReasons":{"type":"array","items":{"type":"string"}},"resourceCosts":{"type":"array","items":{"$ref":"#/$defs/cost"}},"prerequisites":{"type":"array","items":{"type":"string"}},"sourceLinks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},"outcomeAuthority":{"const":"SHARED_PERCENTILE"}}},
    "resolutionMode":{"type":"object","additionalProperties":false,"required":["mode","roll","probabilityAuthority","procedure"],"properties":{"mode":{"enum":["SIMPLIFIED","DETAILED"]},"roll":{"const":"d100"},"probabilityAuthority":{"const":"SHARED_PERCENTILE"},"procedure":{"type":"string","minLength":1}}},
    "repair":{"type":"object","additionalProperties":false,"required":["repairId","type","targetId","description","deterministic"],"properties":{"repairId":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"targetId":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"deterministic":{"const":true}}},
    "validation":{"type":"object","additionalProperties":true,"required":["valid","violations","warnings","statCount","actionCount","availableActionCount","repairCount"],"properties":{"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"statCount":{"type":"integer","minimum":0},"actionCount":{"type":"integer","minimum":0},"availableActionCount":{"type":"integer","minimum":0},"repairCount":{"type":"integer","minimum":0},"preRepairViolations":{"type":"array","items":{"type":"string"}}}}
  }
}
