{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-sectional-dependency-topology.schema.json",
  "title": "Black Light FTL Sectional Dependency Topology Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "profile", "inputReadiness", "aggregateReadiness", "sectionResults", "groupResults", "serviceDiagnostics", "warnings", "provenance"],
  "properties": {
    "status": {"enum": ["READY", "UNRESOLVED", "CONFLICT", "BLOCKED"]},
    "profile": {"type": ["object", "null"]},
    "inputReadiness": {"$ref": "#/$defs/readiness"},
    "aggregateReadiness": {"$ref": "#/$defs/readiness"},
    "sectionResults": {"type": "array", "items": {"$ref": "#/$defs/sectionResult"}},
    "groupResults": {"type": "array", "items": {"$ref": "#/$defs/groupResult"}},
    "serviceDiagnostics": {"type": "object", "additionalProperties": true},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor", "navigation", "reference", "solver", "command", "actuator", "exit", "clearance", "recovery", "thermal", "structure"],
      "properties": {
        "sensor": {"type": "number", "minimum": 0, "maximum": 1},
        "navigation": {"type": "number", "minimum": 0, "maximum": 1},
        "reference": {"type": "number", "minimum": 0, "maximum": 1},
        "solver": {"type": "number", "minimum": 0, "maximum": 1},
        "command": {"type": "number", "minimum": 0, "maximum": 1},
        "actuator": {"type": "number", "minimum": 0, "maximum": 1},
        "exit": {"type": "number", "minimum": 0, "maximum": 1},
        "clearance": {"type": "number", "minimum": 0, "maximum": 1},
        "recovery": {"type": "number", "minimum": 0, "maximum": 1},
        "thermal": {"type": "number", "minimum": 0, "maximum": 1},
        "structure": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "channelLatency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor", "navigation", "reference", "solver", "command", "actuator", "exit", "clearance", "recovery", "thermal", "structure"],
      "properties": {
        "sensor": {"type": ["number", "null"], "minimum": 0},
        "navigation": {"type": ["number", "null"], "minimum": 0},
        "reference": {"type": ["number", "null"], "minimum": 0},
        "solver": {"type": ["number", "null"], "minimum": 0},
        "command": {"type": ["number", "null"], "minimum": 0},
        "actuator": {"type": ["number", "null"], "minimum": 0},
        "exit": {"type": ["number", "null"], "minimum": 0},
        "clearance": {"type": ["number", "null"], "minimum": 0},
        "recovery": {"type": ["number", "null"], "minimum": 0},
        "thermal": {"type": ["number", "null"], "minimum": 0},
        "structure": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "serviceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "latency", "sourceId", "path"],
      "properties": {
        "availability": {"type": "number", "minimum": 0, "maximum": 1},
        "latency": {"type": ["number", "null"], "minimum": 0},
        "sourceId": {"type": ["string", "null"]},
        "path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "localReadiness", "effectiveReadiness", "services", "channelLatencies", "blockedChannels"],
      "properties": {
        "sectionId": {"type": "string"},
        "localReadiness": {"$ref": "#/$defs/readiness"},
        "effectiveReadiness": {"$ref": "#/$defs/readiness"},
        "services": {"type": "object", "additionalProperties": {"$ref": "#/$defs/serviceState"}},
        "channelLatencies": {"$ref": "#/$defs/channelLatency"},
        "blockedChannels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "groupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "channel", "kRequired", "members", "readiness", "latency", "blocked"],
      "properties": {
        "groupId": {"type": "string"},
        "channel": {"type": "string"},
        "kRequired": {"type": "integer", "minimum": 1},
        "members": {"type": "array", "items": {"type": "string"}},
        "readiness": {"type": "number", "minimum": 0, "maximum": 1},
        "latency": {"type": ["number", "null"], "minimum": 0},
        "blocked": {"type": "boolean"}
      }
    }
  }
}
