{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blacklight://schemas/exo-vessel-ftl-maintenance-evidence-integration.schema.json",
  "title": "Black Light FTL Maintenance Evidence Integration Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "adapter", "sourceEvidence", "maintenanceEvidence", "provenance"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["CERTIFIED", "CONDITIONALLY_CERTIFIED", "BLOCKED", "UNRESOLVED", "CONFLICT", "SIMULATION_ONLY"]},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "technologyBasis", "status"],
      "properties": {
        "key": {"enum": ["arnock-solid-state-modular", "zwlei-murrek-fluid-vane", "generic"]},
        "technologyBasis": {"type": "string", "minLength": 1},
        "status": {"enum": ["RESOLVED", "UNRESOLVED", "CONFLICT"]},
        "sourceAuthority": {"type": ["string", "null"]}
      }
    },
    "sourceEvidence": {
      "type": "object",
      "description": "Technology-specific packet preserved without flattening."
    },
    "maintenanceEvidence": {
      "type": "object",
      "description": "Output of the cross-civilization maintenance evidence resolver."
    },
    "familyFirewall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "familyStatus", "inferredFromTechnology"],
      "properties": {
        "family": {"type": ["string", "null"]},
        "familyStatus": {"enum": ["RESOLVED", "UNRESOLVED", "CONFLICT", "NOT_APPLICABLE"]},
        "inferredFromTechnology": {"const": false},
        "notes": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "status", "scope"],
        "properties": {
          "sourceId": {"type": "string"},
          "status": {"type": "string"},
          "scope": {"type": "string"},
          "revision": {"type": ["string", "null"]},
          "epoch": {"type": ["string", "null"]}
        }
      }
    }
  }
}
