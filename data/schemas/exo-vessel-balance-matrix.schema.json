{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-balance-matrix.schema.json",
  "title":"Blacklight EXO Vessel Validation and Balance Matrix",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","matrixSeed","registry","dimensions","cases","aggregate","validation"],
  "properties":{
    "recordType":{"const":"blacklightExoVesselBalanceMatrix"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-11"},
    "matrixSeed":{"type":"string","minLength":1},
    "registry":{"const":"data/exo-vessel/validation-matrix-registry.json"},
    "dimensions":{
      "type":"object",
      "additionalProperties":false,
      "required":["ftlFamilies","pathLevels","missionRoles","biologyProfiles","defenseDoctrines","manufacturerDoctrines","conditionTemplates","combatFits","topologyPolicies"],
      "properties":{
        "ftlFamilies":{"type":"array","minItems":9,"uniqueItems":true,"items":{"type":"string"}},
        "pathLevels":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string"}},
        "missionRoles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "biologyProfiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "defenseDoctrines":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "manufacturerDoctrines":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "conditionTemplates":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "combatFits":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "topologyPolicies":{"type":"array","minItems":5,"uniqueItems":true,"items":{"type":"string"}}
      }
    },
    "cases":{"type":"array","minItems":63,"items":{"$ref":"#/$defs/case"}},
    "aggregate":{"$ref":"#/$defs/aggregate"},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "case":{
      "type":"object",
      "additionalProperties":false,
      "required":["caseId","seed","inputs","identity","topology","counts","closure","statistics","actions","weapons","warnings","repairs","valid","violations"],
      "properties":{
        "caseId":{"type":"string","minLength":1},
        "seed":{"type":"string","minLength":1},
        "inputs":{"type":"object"},
        "identity":{"type":"object"},
        "topology":{"type":"string","minLength":1},
        "counts":{"type":"object"},
        "closure":{"type":"object"},
        "statistics":{"type":"object"},
        "actions":{"type":"object"},
        "weapons":{"type":"array","items":{"type":"object"}},
        "warnings":{"type":"integer","minimum":0},
        "repairs":{"type":"integer","minimum":0},
        "valid":{"type":"boolean"},
        "violations":{"type":"array","items":{"type":"string"}}
      }
    },
    "aggregate":{
      "type":"object",
      "additionalProperties":false,
      "required":["caseCount","validCaseCount","invalidCaseCount","coverage","topologyCounts","closureExtrema","countRanges","statisticRanges","availableActionRange","weaponRangeExtrema","warningCount","repairCount"],
      "properties":{
        "caseCount":{"type":"integer","minimum":63},
        "validCaseCount":{"type":"integer","minimum":0},
        "invalidCaseCount":{"type":"integer","minimum":0},
        "coverage":{"type":"object"},
        "topologyCounts":{"type":"object"},
        "closureExtrema":{"type":"object"},
        "countRanges":{"type":"object"},
        "statisticRanges":{"type":"object"},
        "availableActionRange":{"type":"object"},
        "weaponRangeExtrema":{"type":"object"},
        "warningCount":{"type":"integer","minimum":0},
        "repairCount":{"type":"integer","minimum":0}
      }
    },
    "validation":{
      "type":"object",
      "additionalProperties":false,
      "required":["valid","violations","deterministicReplayCases","requiredCaseCount","observedTopologyCount"],
      "properties":{
        "valid":{"type":"boolean"},
        "violations":{"type":"array","items":{"type":"string"}},
        "deterministicReplayCases":{"type":"integer","minimum":1},
        "requiredCaseCount":{"type":"integer","minimum":63},
        "observedTopologyCount":{"type":"integer","minimum":0,"maximum":5}
      }
    }
  }
}
