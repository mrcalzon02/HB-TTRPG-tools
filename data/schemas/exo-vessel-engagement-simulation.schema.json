{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-engagement-simulation.schema.json",
  "title":"Blacklight EXO Vessel Engagement Monte Carlo Report",
  "type":"object",
  "additionalProperties":false,
  "required":["recordType","schemaVersion","phase","simulationSeed","registry","matrixReport","dimensions","representatives","states","aggregate","validation"],
  "properties":{
    "recordType":{"const":"blacklightExoVesselEngagementSimulation"},
    "schemaVersion":{"const":"1.0.0"},
    "phase":{"const":"VESSEL-11"},
    "simulationSeed":{"type":"string","minLength":1},
    "registry":{"const":"data/exo-vessel/engagement-simulation-registry.json"},
    "matrixReport":{"type":"string","minLength":1},
    "dimensions":{"type":"object"},
    "representatives":{"type":"array","minItems":1,"items":{"type":"object"}},
    "states":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/state"}},
    "aggregate":{"type":"object"},
    "validation":{"$ref":"#/$defs/validation"}
  },
  "$defs":{
    "state":{
      "type":"object",
      "additionalProperties":false,
      "required":["stateId","weaponFamily","representativeCaseId","engagementBand","targetEvasionPercent","trials","outcomes","meanImpactProbabilityPercent","observedImpactRatePercent","meanResidualEnergyJ","meanRetainedEnergyPercent","meanDamagedModuleCount","meanDetachedModuleCount","meanSeveredRouteCount","meanCompromisedZoneCount","meanReadinessLossPercent","balanceScore","available"],
      "properties":{
        "stateId":{"type":"string"},
        "weaponFamily":{"type":"string"},
        "representativeCaseId":{"type":"string"},
        "engagementBand":{"type":"string"},
        "targetEvasionPercent":{"type":"number","minimum":0,"maximum":100},
        "trials":{"type":"integer","minimum":1},
        "outcomes":{"type":"object"},
        "meanImpactProbabilityPercent":{"type":"number","minimum":0,"maximum":100},
        "observedImpactRatePercent":{"type":"number","minimum":0,"maximum":100},
        "meanResidualEnergyJ":{"type":"number","minimum":0},
        "meanRetainedEnergyPercent":{"type":"number","minimum":0,"maximum":100},
        "meanDamagedModuleCount":{"type":"number","minimum":0},
        "meanDetachedModuleCount":{"type":"number","minimum":0},
        "meanSeveredRouteCount":{"type":"number","minimum":0},
        "meanCompromisedZoneCount":{"type":"number","minimum":0},
        "meanReadinessLossPercent":{"type":"number","minimum":0,"maximum":100},
        "balanceScore":{"type":"number","minimum":0},
        "available":{"type":"boolean"}
      }
    },
    "validation":{
      "type":"object",
      "additionalProperties":false,
      "required":["valid","violations","weaponFamilyCount","stateCount","trialCount","deterministicReplayPassed","dominantWeaponFamily"],
      "properties":{
        "valid":{"type":"boolean"},
        "violations":{"type":"array","items":{"type":"string"}},
        "weaponFamilyCount":{"type":"integer","minimum":0},
        "stateCount":{"type":"integer","minimum":0},
        "trialCount":{"type":"integer","minimum":0},
        "deterministicReplayPassed":{"type":"boolean"},
        "dominantWeaponFamily":{"type":["string","null"]}
      }
    }
  }
}
