{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-weapon-engagement.schema.json",
  "title": "Blacklight EXO Vessel Weapon-Family Engagement Model",
  "description": "VESSEL-07 installed weapon-family and hard-kill countermeasure engineering envelopes derived from vessel technology discipline, conventional engine generation, subsystem variants, surviving modules, native operative methodology, VESSEL-06 tracks, target maneuver, and active-defense assumptions without resolving local impacts or damage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType","schemaVersion","phase","vesselInstanceId","weaponSeed","validationMode","referenceAuthority","scenario","engagements","countermeasureEnvelopes","summary","repairLog","deferredSystems","validation"],
  "properties": {
    "recordType": {"const": "exoVesselWeaponEngagementModel"},
    "schemaVersion": {"const": "1.1.0"},
    "phase": {"const": "VESSEL-07"},
    "vesselInstanceId": {"type": "string", "pattern": "^vessel-[a-z0-9][a-z0-9-]{5,95}$"},
    "weaponSeed": {"type": "string", "minLength": 1},
    "validationMode": {"enum": ["REPAIR","STRICT"]},
    "referenceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technologyDiscipline","engineeringLedger","propulsionTechnology","moduleGraph","conditionHistory","combatGeometry","technologyBasis"],
      "properties": {
        "technologyDiscipline": {"const": "VESSEL-00_PRINCIPAL_BAND_AND_SUBSYSTEM_VARIANTS"},
        "engineeringLedger": {"const": "VESSEL-02_INSTALLED_WEAPON_AND_COUNTERMEASURE_REFERENCE"},
        "propulsionTechnology": {"const": "VESSEL-02_CONVENTIONAL_ENGINE_GENERATION_AND_POWER_CLASS"},
        "moduleGraph": {"const": "VESSEL-03_HARDPOINT_AND_SUPPORT_REFERENCE"},
        "conditionHistory": {"const": "VESSEL-05_SURVIVING_MODULE_AND_GRAPH_AUTHORITY"},
        "combatGeometry": {"const": "VESSEL-06_TRACK_AND_FIRE_CONTROL_REFERENCE"},
        "technologyBasis": {"const": "SPECIES_AND_MANUFACTURER_OPERATIVE_METHODOLOGY"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetActiveDefensePercent","targetPointDefenseChannels","targetCountermeasureQualityPercent"],
      "properties": {
        "targetActiveDefensePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "targetPointDefenseChannels": {"type": "integer", "minimum": 0},
        "targetCountermeasureQualityPercent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "engagements": {"type": "array", "items": {"$ref": "#/$defs/engagement"}},
    "countermeasureEnvelopes": {"type": "array", "items": {"$ref": "#/$defs/countermeasure"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedWeaponFamilies","operationalWeaponFamilies","installedCountermeasureMissileFamilies","operationalCountermeasureMissileFamilies"],
      "properties": {
        "installedWeaponFamilies": {"type": "integer", "minimum": 0},
        "operationalWeaponFamilies": {"type": "integer", "minimum": 0},
        "installedCountermeasureMissileFamilies": {"type": "integer", "minimum": 0},
        "operationalCountermeasureMissileFamilies": {"type": "integer", "minimum": 0}
      }
    },
    "repairLog": {"type": "array", "items": {"$ref": "#/$defs/repair"}},
    "deferredSystems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDamageResolution","gameplayActions"],
      "properties": {"localDamageResolution": {"const": "VESSEL-08"}, "gameplayActions": {"const": "VESSEL-09"}}
    },
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bandKey","rangeM","timeToEffectSeconds","informationAgeAtEffectSeconds","trackUncertaintyAtEffectM","targetManeuverEnvelopeM","aimOrFootprintRadiusM","solutionQualityPercent","effectRetentionPercent","activeDefenseSurvivalPercent","status","limitingFactors"],
      "properties": {
        "bandKey": {"enum": ["pointDefense","practical","harassment","theoretical"]},
        "rangeM": {"type": "number", "minimum": 0},
        "timeToEffectSeconds": {"type": "number", "minimum": 0},
        "informationAgeAtEffectSeconds": {"type": "number", "minimum": 0},
        "trackUncertaintyAtEffectM": {"type": "number", "minimum": 0},
        "targetManeuverEnvelopeM": {"type": "number", "minimum": 0},
        "aimOrFootprintRadiusM": {"type": "number", "minimum": 0},
        "solutionQualityPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "effectRetentionPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "activeDefenseSurvivalPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "status": {"enum": ["AVAILABLE","UNAVAILABLE","NOT_APPLICABLE","PHYSICALLY_REACHABLE"]},
        "limitingFactors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointDefense","practical","harassment","theoretical"],
      "properties": {
        "pointDefense": {"$ref": "#/$defs/band"},
        "practical": {"$ref": "#/$defs/band"},
        "harassment": {"$ref": "#/$defs/band"},
        "theoretical": {"$ref": "#/$defs/band"}
      }
    },
    "operational": {"type": "object", "additionalProperties": true, "required": ["mountModuleId","mountOperational","technologyEligible","availabilityFactor","effectiveRounds","trackReady","ready"]},
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basisId","primaryBasisKey","primaryLabel","operativeTheory","controlMethod","actuationMethod","thermalMethod","carrierInterfaces","humanInteroperability"],
      "properties": {
        "basisId": {"type": ["string","null"]},
        "primaryBasisKey": {"type": ["string","null"]},
        "primaryLabel": {"type": ["string","null"]},
        "operativeTheory": {"type": ["string","null"]},
        "controlMethod": {"type": ["string","null"]},
        "actuationMethod": {"type": ["string","null"]},
        "thermalMethod": {"type": ["string","null"]},
        "carrierInterfaces": {"type": "array", "items": {"type": "object"}},
        "humanInteroperability": {"type": ["string","null"]}
      }
    },
    "subsystemVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subsystemKey","principalBand","variant","technologyIndex","heritageBand","source"],
      "properties": {
        "subsystemKey": {"type": "string", "minLength": 1},
        "principalBand": {"enum": ["T-1","P0","P1","P2","P3","P4","P5","P6"]},
        "variant": {"enum": ["LEGACY","STANDARD","REFINED","ADVANCED","PROTOTYPE"]},
        "technologyIndex": {"type": "number", "minimum": -1.3, "maximum": 6.3},
        "heritageBand": {"enum": ["T-1","P0","P1","P2","P3","P4","P5","P6"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "technologyAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityType","principalBand","principalRank","pathLevelKey","pathLevelRank","ftlFamilyKey","conventionalEngineKey","conventionalEngineLabel","conventionalEngineTechnologyBand","conventionalEngineRank","conventionalEngineSpecificPowerWKg","authorityCeilingRank","minimumTechnologyRank","subsystemVariants","bottleneckTechnologyIndex","averageTechnologyIndex","effectiveTechnologyIndex","maturityFactor","enginePowerClassFactor","powerDependence","performanceFactor","eligible","policy"],
      "properties": {
        "authorityType": {"const": "VESSEL_TECHNOLOGY_AND_ENGINE_CEILING"},
        "principalBand": {"enum": ["P0","P1","P2","P3","P4","P5","P6"]},
        "principalRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "pathLevelKey": {"type": ["string","null"]},
        "pathLevelRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "ftlFamilyKey": {"type": ["string","null"]},
        "conventionalEngineKey": {"type": ["string","null"]},
        "conventionalEngineLabel": {"type": ["string","null"]},
        "conventionalEngineTechnologyBand": {"enum": ["P0","P1","P2","P3","P4","P5","P6"]},
        "conventionalEngineRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "conventionalEngineSpecificPowerWKg": {"type": "number", "exclusiveMinimum": 0},
        "authorityCeilingRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "minimumTechnologyRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "subsystemVariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subsystemVariant"}},
        "bottleneckTechnologyIndex": {"type": "number", "minimum": -1.3, "maximum": 6.3},
        "averageTechnologyIndex": {"type": "number", "minimum": -1.3, "maximum": 6.3},
        "effectiveTechnologyIndex": {"type": "number", "minimum": -1, "maximum": 6.3},
        "maturityFactor": {"type": "number", "minimum": 0},
        "enginePowerClassFactor": {"type": "number", "exclusiveMinimum": 0},
        "powerDependence": {"type": "number", "minimum": 0, "maximum": 1},
        "performanceFactor": {"type": "number", "minimum": 0},
        "eligible": {"type": "boolean"},
        "policy": {"type": "string", "minLength": 1}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode","technologyRank","technologyIndex","technologyAuthority","basisModifier","physicalMaximumRangeM","pointDefenseMaxSeconds","energyOrPowerAuthority"],
      "properties": {
        "mode": {"enum": ["KINETIC_UNGUIDED","KINETIC_GUIDED","PARTICULATE_CLOUD","DIRECTED_ENERGY","GUIDED_MISSILE","GUIDED_INTERCEPTOR"]},
        "technologyRank": {"type": "integer", "minimum": 0, "maximum": 6},
        "technologyIndex": {"type": "number", "minimum": -1, "maximum": 6.3},
        "technologyAuthority": {"$ref": "#/$defs/technologyAuthority"},
        "basisModifier": {"type": "object"},
        "physicalMaximumRangeM": {"type": "number", "minimum": 0},
        "pointDefenseMaxSeconds": {"type": "number", "minimum": 0},
        "energyOrPowerAuthority": {"type": "string", "minLength": 1}
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagementId","installationIndex","weaponFamily","label","hardpointId","mountModuleId","facing","arc","trackId","targetClass","targetSizeM","installedAllocation","operationalState","nativeMethodology","performance","bands","constraints"],
      "properties": {
        "engagementId": {"type": "string", "minLength": 1},
        "installationIndex": {"type": "integer", "minimum": 0},
        "weaponFamily": {"enum": ["CHEMICAL_BALLISTIC","RAIL_GUN","COIL_GUN","BRUTE_MASS_THROWER","SAND_GUN","LASER","PARTICLE_BEAM","FRACTIONAL_C","MISSILE"]},
        "label": {"type": "string", "minLength": 1},
        "hardpointId": {"type": ["string","null"]},
        "mountModuleId": {"type": ["string","null"]},
        "facing": {"type": ["string","null"]},
        "arc": {"type": ["object","null"]},
        "trackId": {"type": ["string","null"]},
        "targetClass": {"type": "string"},
        "targetSizeM": {"type": "number", "exclusiveMinimum": 0},
        "installedAllocation": {"type": "object"},
        "operationalState": {"$ref": "#/$defs/operational"},
        "nativeMethodology": {"$ref": "#/$defs/methodology"},
        "performance": {"$ref": "#/$defs/performance"},
        "bands": {"$ref": "#/$defs/bands"},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["impactResolutionDeferred","damageResolutionDeferred","localVoxelResolutionDeferred","sourceTrackStatus","sourceFireControlStatus"],
          "properties": {
            "impactResolutionDeferred": {"const": true},
            "damageResolutionDeferred": {"const": true},
            "localVoxelResolutionDeferred": {"const": true},
            "sourceTrackStatus": {"type": "string"},
            "sourceFireControlStatus": {"type": "string"}
          }
        }
      }
    },
    "countermeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countermeasureEnvelopeId","countermeasureType","label","moduleId","unitCount","effectiveUnitCount","functions","operationalState","nativeMethodology","performance","bands","targetAssumption","constraints"],
      "properties": {
        "countermeasureEnvelopeId": {"type": "string", "minLength": 1},
        "countermeasureType": {"const": "INTERCEPTOR"},
        "label": {"type": "string", "minLength": 1},
        "moduleId": {"type": ["string","null"]},
        "unitCount": {"type": "integer", "minimum": 0},
        "effectiveUnitCount": {"type": "integer", "minimum": 0},
        "functions": {"type": "array", "items": {"type": "string"}},
        "operationalState": {"$ref": "#/$defs/operational"},
        "nativeMethodology": {"$ref": "#/$defs/methodology"},
        "performance": {"$ref": "#/$defs/performance"},
        "bands": {"$ref": "#/$defs/bands"},
        "targetAssumption": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interceptResolutionDeferred","localDamageResolutionDeferred"],
          "properties": {"interceptResolutionDeferred": {"const": true}, "localDamageResolutionDeferred": {"const": true}}
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repairId","type","targetId","description","deterministic"],
      "properties": {"repairId": {"type": "string"}, "type": {"type": "string"}, "targetId": {"type": "string"}, "description": {"type": "string"}, "deterministic": {"const": true}}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid","violations","warnings","engagementCount","countermeasureEnvelopeCount","repairCount"],
      "properties": {
        "valid": {"type": "boolean"},
        "violations": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "engagementCount": {"type": "integer", "minimum": 0},
        "countermeasureEnvelopeCount": {"type": "integer", "minimum": 0},
        "repairCount": {"type": "integer", "minimum": 0},
        "preRepairViolations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
