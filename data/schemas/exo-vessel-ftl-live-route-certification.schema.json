{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-ftl-live-route-certification.schema.json",
  "title": "Black Light EXO FTL Live Route Certification Export Extension",
  "description": "Validation boundary for the live route-safety certificate and route matrix appended to an EXO FTL dossier. This schema describes implementation/export structure only and does not promote simulation calibration into setting canon.",
  "type": "object",
  "required": ["routeSafetyCertificate", "routeSafetyMatrix", "certificationExport"],
  "properties": {
    "routeSafetyCertificate": {"$ref": "#/$defs/routeResult"},
    "routeSafetyMatrix": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/routeResult"}
    },
    "certificationExport": {
      "type": "object",
      "required": ["schemaVersion", "generatedCapabilityIsNotRouteCertification", "blocked", "status", "routeSelectorGuarded", "provenance"],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "generatedCapabilityIsNotRouteCertification": {"const": true},
        "blocked": {"type": "boolean"},
        "status": {"$ref": "#/$defs/status"},
        "routeSelectorGuarded": {"type": "boolean"},
        "provenance": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["ADMISSIBLE", "MARGINAL", "REJECTED", "UNRESOLVED", "CONFLICT"]
    },
    "profileIdentity": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "properties": {
            "profileId": {"type": ["string", "null"]},
            "profileVersion": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "routeResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "family": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "route": {"type": ["string", "null"]},
        "calibration": {
          "type": ["object", "null"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "profileIdentity": {"$ref": "#/$defs/profileIdentity"},
            "appliedOverrides": {"type": "array"},
            "ignoredOverrides": {"type": "array"},
            "warnings": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "certificate": {
          "type": ["object", "null"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "familyResponse": {"type": "object"},
            "sensorLookahead": {"type": "object"},
            "hazardObservability": {"type": "object"},
            "recoveryReserve": {"type": "object"},
            "environmentSeverity": {"type": "object"},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "provenance": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "presentation": {
          "type": "object",
          "properties": {
            "label": {"type": "string"},
            "blocking": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-blacklight-authority": {
    "status": "DERIVED",
    "canonRule": "This schema validates transport of certification data. It does not establish FTL physics, named-race capabilities, historical ownership, or physical constants.",
    "designIntentSource": {
      "title": "The different lightspeed methods",
      "documentId": "1e0Xp71EFubBZgXWjjvPxAqPoJIZNwqS6nu1-r7Kil7Y",
      "revisionId": "ANLCKQllC5h6dLaX5H1RpK8aUFVWsi-IV7gbMHUd0Qq7mIe5uGsLFi5_Hrsr8B6dl8t_ezB0fTSygxrnIBtifAHW79bgSbswp1zF3NaEil0"
    }
  }
}
