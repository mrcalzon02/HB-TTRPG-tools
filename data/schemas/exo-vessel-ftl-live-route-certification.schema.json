{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/schemas/exo-vessel-ftl-live-route-certification.schema.json",
  "title": "Black Light EXO FTL Live Route Certification & Control Embodiment Export Extension",
  "description": "Validation boundary for the live route-safety certificate, route matrix, and operative-technology control embodiment appended to an EXO FTL dossier. This schema describes implementation/export structure only and does not promote simulation calibration or generic embodiment into setting canon.",
  "type": "object",
  "required": ["routeSafetyCertificate", "routeSafetyMatrix", "controlEmbodiment", "certificationExport"],
  "properties": {
    "routeSafetyCertificate": {"$ref": "#/$defs/routeResult"},
    "routeSafetyMatrix": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/routeResult"}
    },
    "controlEmbodiment": {
      "oneOf": [
        {"$ref": "#/$defs/controlEmbodiment"},
        {"type": "null"}
      ]
    },
    "certificationExport": {
      "type": "object",
      "required": ["schemaVersion", "generatedCapabilityIsNotRouteCertification", "blocked", "status", "routeSelectorGuarded", "technologyBasisExplicit", "controlEmbodimentStatus", "generatedFamilyPreserved", "provenance"],
      "properties": {
        "schemaVersion": {"const": "1.2.0"},
        "generatedCapabilityIsNotRouteCertification": {"const": true},
        "blocked": {"type": "boolean"},
        "status": {"$ref": "#/$defs/status"},
        "routeSelectorGuarded": {"type": "boolean"},
        "technologyBasisExplicit": {"type": "boolean"},
        "controlEmbodimentStatus": {"type": "string", "enum": ["READY", "UNRESOLVED"]},
        "generatedFamilyPreserved": {"const": true},
        "provenance": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["ADMISSIBLE", "MARGINAL", "REJECTED", "UNRESOLVED", "CONFLICT"]
    },
    "profileIdentity": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "properties": {
            "profileId": {"type": ["string", "null"]},
            "profileVersion": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        {"type": "null"}
      ]
    },
    "routeResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "family": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "route": {"type": ["string", "null"]},
        "calibration": {
          "type": ["object", "null"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "profileIdentity": {"$ref": "#/$defs/profileIdentity"},
            "appliedOverrides": {"type": "array"},
            "ignoredOverrides": {"type": "array"},
            "warnings": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "certificate": {
          "type": ["object", "null"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "familyResponse": {"type": "object"},
            "sensorLookahead": {"type": "object"},
            "hazardObservability": {"type": "object"},
            "recoveryReserve": {"type": "object"},
            "environmentSeverity": {"type": "object"},
            "reasons": {"type": "array", "items": {"type": "string"}},
            "provenance": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "presentation": {
          "type": "object",
          "properties": {
            "label": {"type": "string"},
            "blocking": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "controlEmbodiment": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["READY", "UNRESOLVED"]},
        "technologyBasis": {"type": ["string", "null"]},
        "basisClass": {"type": ["string", "null"]},
        "provenanceClass": {"type": ["string", "null"]},
        "transitFamily": {"type": ["string", "null"]},
        "transitFamilyProvenance": {"type": ["string", "null"]},
        "navigationRepresentation": {"type": ["array", "object", "string", "null"]},
        "sensorArchitecture": {"type": ["array", "object", "string", "null"]},
        "controlArchitecture": {"type": ["array", "object", "string", "null"]},
        "abortEmbodiment": {"type": ["array", "object", "string", "null"]},
        "maintenanceDoctrine": {"type": ["array", "object", "string", "null"]},
        "failureSignatures": {"type": ["array", "object", "string", "null"]},
        "serviceEnvironment": {"type": ["array", "object", "string", "null"]},
        "humanInteroperability": {"type": ["string", "null"]},
        "scaling": {"type": ["array", "object", "string", "null"]},
        "infrastructure": {"type": ["array", "object", "string", "null"]},
        "canonWarnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "x-blacklight-authority": {
    "status": "DERIVED",
    "canonRule": "This schema validates transport of certification and control-embodiment data. It does not establish FTL physics, named-race capabilities, historical ownership, physical constants, or an unresolved named species' transit family.",
    "embodimentRule": "An unspecified technology basis remains UNRESOLVED. Generic technology-basis embodiment may alter machinery form and operator representation but may not change the generated/certified transit family or erase invariant safety channels.",
    "designIntentSource": {
      "title": "The different lightspeed methods",
      "documentId": "1e0Xp71EFubBZgXWjjvPxAqPoJIZNwqS6nu1-r7Kil7Y",
      "revisionId": "ANLCKQllC5h6dLaX5H1RpK8aUFVWsi-IV7gbMHUd0Qq7mIe5uGsLFi5_Hrsr8B6dl8t_ezB0fTSygxrnIBtifAHW79bgSbswp1zF3NaEil0"
    }
  }
}
