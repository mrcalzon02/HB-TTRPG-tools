      "AES-GCM envelope sealing",
      "authenticated envelope opening",
      "wrong envelope passphrase rejection",
      "authenticated metadata tamper rejection",
      "custom editor protected draft loading",
      "custom editor invalid draft rejection without active-key mutation",
      "custom editor undo and redo",
      "custom editor validated apply with fingerprint recalculation and package clearing",
      "custom editor previous valid key recovery",
