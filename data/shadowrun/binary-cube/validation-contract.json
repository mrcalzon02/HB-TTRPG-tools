{
  "receiptType": "shadowrunBinaryCubeValidationContract",
  "schemaVersion": "0.5.0",
  "branchPolicy": "main only",
  "securityClassification": {
    "cubeCore": "experimental-ttrpg-obfuscation-not-production-cryptography",
    "optionalEnvelope": "PBKDF2-SHA-256 derived AES-GCM authenticated transport around the experimental package"
  },
  "requiredStaticValidation": {
    "validator": "scripts/validate-shadowrun-binary-cube.mjs",
    "minimumAssertions": 14258,
    "minimumRoundTrips": 3840,
    "recommendedGridSizes": [4, 12, 20, 28, 36, 44, 52, 60],
    "directedLegalFacePairs": 24,
    "gridFourMatrix": {
      "inputFaces": 6,
      "legalOutputFacesPerInput": 4,
      "inputOrientations": 4,
      "outputOrientations": 4,
      "maskDensities": [1, 0.75, 0.5],
      "payloadLengthsPerConfiguration": 3
    },
    "mandatoryFailureCases": [
      "non-binary input",
      "same or opposite face misuse",
      "wrong key",
      "ciphertext corruption",
      "framing metadata corruption",
      "key fingerprint mismatch",
      "invalid permutation",
      "unsupported schema",
      "truncated block"
    ]
  },
  "requiredCustomEditorValidation": {
    "validator": "scripts/validate-shadowrun-binary-cube-editor.mjs",
    "minimumAssertions": 252,
    "minimumRoundTrips": 40,
    "recommendedGridSizes": [4, 12, 20, 28, 36, 44, 52, 60],
    "requiredMaskPatterns": ["full", "three-quarter", "half", "border", "diagonal"],
    "maximumVisualGridSize": 12,
    "requiredCapabilities": [
      "protected draft isolated from the active key",
      "row column and depth permutation editing",
      "text and keyboard-accessible visual mask editing",
      "large-grid textual summary instead of unbounded cell rendering",
      "range and uniqueness validation",
      "nonempty mask validation",
      "all-six-face projection validation",
      "key fingerprint recalculation",
      "undo and redo",
      "previous valid key recovery",
      "incompatible package clearing after key replacement"
    ],
    "mandatoryFailureCases": [
      "duplicate permutation value",
      "out-of-range permutation value",
      "short permutation",
      "wrong draft grid size",
      "empty mask",
      "non-binary mask",
      "wrong mask length",
      "prior package used with rebuilt key"
    ]
  },
  "requiredTextControlValidation": {
    "validator": "scripts/validate-shadowrun-binary-cube-text-controls.mjs",
    "manifest": "data/shadowrun/binary-cube/text-control-manifest.json",
    "referenceSummary": "data/shadowrun/binary-cube/text-control-reference-summary.json",
    "minimumAssertions": 630,
    "minimumRoundTrips": 40,
    "documentCount": 5,
    "controlKeyCount": 8,
    "encoding": "UTF-8",
    "lineEndingPolicy": "LF only with a terminal line feed",
    "sourceBytesPerCorpusPass": 1550,
    "sourceBitsPerCorpusPass": 12400,
    "expectedEncryptedBits": 164976,
    "matrixCanonicalSha256": "fbcb643e4ace66b00f167ab049a1d46b09aa5900995a9e6c9f60dd83c9a60bb1",
    "requiredDocumentControls": [
      "lorem-ipsum-basic",
      "speech-to-text-lorem-control",
      "formatting-whitespace-control",
      "unicode-lossless-control",
      "lorem-ipsum-multiblock"
    ],
    "requiredGridSizes": [4, 12, 20, 28, 36, 44, 52, 60],
    "requiredComparisons": [
      "source SHA-256 and byte length",
      "UTF-8 decode and re-encode byte identity",
      "known deterministic key identifier and payload capacity",
      "deterministic independent encryption",
      "package JSON serialization identity",
      "package checksum validation",
      "decrypted binary identity",
      "recovered byte identity",
      "recovered text identity",
      "recovered SHA-256 identity",
      "aggregate ciphertext length",
      "full matrix canonical SHA-256"
