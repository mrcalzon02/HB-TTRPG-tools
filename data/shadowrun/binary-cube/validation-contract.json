    "mandatoryFailureCases": [
      "wrong passphrase",
      "ciphertext modification",
      "associated key identifier modification",
      "associated KDF metadata modification",
      "unsupported envelope schema",
      "malformed Base64",
      "incorrect salt length",
      "unsupported cipher profile",
      "short passphrase",
