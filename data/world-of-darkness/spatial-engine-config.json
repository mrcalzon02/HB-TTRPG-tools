{
  "schemaVersion": "2.4.0",
  "mapMode": "leaflet-openstreetmap-lazy-manual-scan",
  "performance": {
    "lazyStartOnWorldOfDarknessView": true,
    "startupGeocode": false,
    "startupBusinessScan": false,
    "autoScanDefault": false,
    "autoScanIdleDelayMs": 3500,
    "autoScanCooldownMs": 12000,
    "viewportCacheTtlMs": 600000,
    "maximumVisibleResults": 90
  },
  "namedLocationMatching": {
    "scanScope": "all-openstreetmap-nodes-ways-and-relations-with-name-tag",
    "eligibleExamples": [
      "businesses",
      "named buildings",
      "roads and streets",
      "parks and green spaces",
      "schools and campuses",
      "religious sites",
      "historic sites and monuments",
      "natural and water features",
      "trails and paths",
      "transit locations",
      "public and civic facilities",
      "named neighborhoods and boundaries"
    ],
    "viewportServerResultCaps": {
      "small": 1200,
      "medium": 900,
      "large": 600
    },
    "clientVisibleResultCap": 90,
    "denseAreaGuidance": "zoom-closer-and-rescan-when-server-cap-is-reached",
