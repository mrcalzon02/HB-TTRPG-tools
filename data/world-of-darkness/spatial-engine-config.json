{
  "schemaVersion": "2.6.0",
  "mapMode": "leaflet-openstreetmap-lazy-manual-scan",
  "performance": {
    "lazyStartOnWorldOfDarknessView": true,
    "startupGeocode": false,
    "startupBusinessScan": false,
    "autoScanDefault": false,
    "autoScanIdleDelayMs": 3500,
    "autoScanCooldownMs": 12000,
    "viewportCacheTtlMs": 600000,
    "maximumVisibleResults": 90
  },
  "namedLocationMatching": {
    "scanScope": "all-openstreetmap-nodes-ways-and-relations-with-name-tag",
    "eligibleExamples": [
      "businesses",
      "named buildings",
      "roads and streets",
      "parks and green spaces",
      "schools and campuses",
      "religious sites",
      "historic sites and monuments",
      "natural and water features",
      "trails and paths",
      "transit locations",
      "public and civic facilities",
      "fitness and sports facilities",
      "named neighborhoods and boundaries"
    ],
    "viewportServerResultCaps": { "small": 1200, "medium": 900, "large": 600 },
    "clientVisibleResultCap": 90,
    "denseAreaGuidance": "zoom-closer-and-rescan-when-server-cap-is-reached",
    "legacyBusinessOnlyCacheMigration": "clear-once"
  },
  "worldScan": {
    "localVisibleLocationCap": 90,
    "globalViewportProcessingCap": 90,
    "globalSubmissionModel": "compact-viewport-manifest-with-server-side-all-named-rescan",
    "globalRegistryBehavior": "add-only-missing-packages-under-active-world-seed",
    "globalCoverageTracking": "bounds-zoom-center-game-line-package-keys-and-server-result-count",
    "claimedLocationBehavior": "defer-to-future-claimed-business-integration"
  },
  "contextAwareGeneration": {
    "model": "additive-context-matrix-plus-compositional-detail-diversity",
    "selectionInputs": [
      "world seed",
      "stable real-location key",
      "inventory status",
      "active game line",
      "mapped category",
      "named-feature class",
      "retained OpenStreetMap tags",
      "quantized neighborhood cell",
      "nearby values already used in the current radial pass"
    ],
    "supportedGameLines": ["unified", "vampire", "werewolf", "breeds", "hunter", "changeling", "mage"],
    "baseContextCount": 21,
    "addedContextCount": 21,
    "effectiveContextCount": 42,
    "prototypeCount": 10,
    "effectiveLocationVariants": 420,
    "baseEntriesPerOutputPool": 8,
    "addedEntriesPerOutputPool": 8,
    "effectiveEntriesPerOutputPool": 16,
    "detailDiversity": {
      "schemaVersion": "1.0.0",
      "neighborhoodCellDegrees": 0.015,
      "regionalThemePolicy": "stable-by-neighborhood-cell-and-game-line",
      "localDetailPolicy": "field-salted-deterministic-selection-with-neighborhood-used-value-avoidance",
      "legacyCharacterPrototypeUse": false,
      "legacyRumorBundleUse": false,
      "independentlySelectedComponents": 21,
      "minimumPublicFacadeCombinations": 9216,
      "minimumSensoryCombinations": 576,
      "minimumMediaCombinations": 6144,
      "minimumRumorCombinations": 6144,
      "minimumCharacterPresentationCombinationsPerGameLine": 82944
    },
    "immutability": "existing published packages remain unchanged; enrichment applies only during the new package transaction"
  },
  "influenceOverlay": {
    "generatedLayerModel": "provisional-circles-from-world-seeded-packages",
    "curatedLayerModel": "repository-backed-geojson-compatible-features",
    "localStyle": "dashed",
    "globalStyle": "solid",
    "statusRadiusMeters": { "TANGENTIAL": 120, "ACTIVE_UNREGISTERED": 240, "INVENTORIED": 420 }
  },
  "locationDistribution": {
    "baseTotalVariants": 210,
    "effectiveTotalVariants": 420,
    "variantsPerArchetype": 42,
    "mundaneCountPerArchetype": 24,
    "tangentialCountPerArchetype": 12,
    "activeUnregisteredCountPerArchetype": 4,
    "inventoriedCountPerArchetype": 2,
    "mundanePercent": 57.14,
    "tangentialPercent": 28.57,
    "activeUnregisteredPercent": 9.52,
    "inventoriedPercent": 4.76,
    "mundaneOrTangentialPercent": 85.71,
    "notInventoriedPercent": 95.24
  },
  "coreData": {
    "locations": "data/world-of-darkness/locations_core_v2.json",
    "contextExpansion": "data/world-of-darkness/location_context_expansion_v3.json",
    "detailDiversity": "data/world-of-darkness/location_detail_diversity_v1.json",
    "characters": "data/world-of-darkness/characters_core.json",
    "rumors": "data/world-of-darkness/rumors_core.json",
    "centralRegistry": "data/world-of-darkness/poi_registry.json",
    "crosslinks": "data/world-of-darkness/location_crosslink_core.json",
    "crosslinkExpansion": "data/world-of-darkness/location_crosslink_expansion_v2.json",
    "generatedLocationRegistry": "data/world-of-darkness/generated_location_registry.json",
    "influenceOverlayRegistry": "data/world-of-darkness/influence_overlay_registry.json"
  },
  "worldSeeds": {
    "model": "local-and-embedded-selectable-world-seeds",
    "packageIdentity": "world-seed-key-plus-location-key-plus-game-line",
    "globalBehavior": "stack-packages-across-seeds-without-overwrite",
    "immutability": "published-packages-must-be-deleted-before-regeneration",
    "claimedBusinessIntegration": "deferred"
  },
  "persistence": {
    "baseline": "deterministic-named-location-key-and-coordinate-seed",
    "localOverrides": "localStorage",
    "localWorldSeeds": "localStorage",
    "localGeneratedPackages": "localStorage",
    "localScanCoverage": "localStorage",
    "centralOverrides": "static-repository-registry",
    "embeddedWorlds": "generated-location-registry",
    "globalScanCoverage": "generated-location-registry-world-scanCoverage",
    "curatedInfluence": "influence-overlay-registry"
  },
