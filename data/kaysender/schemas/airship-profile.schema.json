{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/kaysender/schemas/airship-profile.schema.json",
  "title": "Kaysender Airship / Vessel Profile",
  "type": "object",
  "required": [
    "name",
    "profileType",
    "vesselClass",
    "hullCulture",
    "coreType",
    "purpose",
    "legalStatus",
    "crewQuality",
    "crewScale",
    "captainStyle",
    "cargoProfile",
    "armament",
    "defenseSystem",
    "condition",
    "maintenancePressure",
    "routeAccess",
    "factionEntanglement",
    "hiddenProblem",
    "currentMission",
    "moraleState",
    "fuelSupply",
    "derivedScores",
    "outputs"
  ],
  "properties": {
    "name": { "type": "string" },
    "profileType": { "type": "string", "const": "airship-profile" },
    "sourceIslandProfile": { "type": ["object", "null"] },
    "sourceSettlementProfile": { "type": ["object", "null"] },
    "vesselClass": { "type": "string" },
    "hullCulture": { "type": "string" },
    "coreType": { "type": "string" },
    "purpose": { "type": "string" },
    "legalStatus": { "type": "string" },
    "crewQuality": { "type": "string" },
    "crewScale": { "type": "string" },
    "captainStyle": { "type": "string" },
    "cargoProfile": { "type": "string" },
    "armament": { "type": "string" },
    "defenseSystem": { "type": "string" },
    "condition": { "type": "string" },
    "maintenancePressure": { "type": "string" },
    "routeAccess": { "type": "string" },
    "routeMandate": { "type": "string" },
    "factionEntanglement": { "type": "string" },
    "hiddenProblem": { "type": "string" },
    "currentMission": { "type": "string" },
    "moraleState": { "type": "string" },
    "fuelSupply": { "type": "string" },
    "portOfCall": { "type": "string" },
    "derivedScores": {
      "type": "object",
      "required": ["airworthiness", "cargoValue", "combatThreat", "maintenanceRisk", "legalRisk", "crewMorale", "adventureDensity", "routeCompatibility"],
      "properties": {
        "airworthiness": { "type": "integer" },
        "cargoValue": { "type": "integer" },
        "combatThreat": { "type": "integer" },
        "maintenanceRisk": { "type": "integer" },
        "legalRisk": { "type": "integer" },
        "crewMorale": { "type": "integer" },
        "adventureDensity": { "type": "integer" },
        "routeCompatibility": { "type": "integer" }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["summary", "technicalNotes", "crewHooks", "cargoHooks", "routeHooks", "factionHooks", "maintenanceHooks", "encounterHooks", "wikiDraft"],
      "properties": {
        "summary": { "type": "string" },
        "technicalNotes": { "type": "array", "items": { "type": "string" } },
        "crewHooks": { "type": "array", "items": { "type": "string" } },
        "cargoHooks": { "type": "array", "items": { "type": "string" } },
        "routeHooks": { "type": "array", "items": { "type": "string" } },
        "factionHooks": { "type": "array", "items": { "type": "string" } },
        "maintenanceHooks": { "type": "array", "items": { "type": "string" } },
        "encounterHooks": { "type": "array", "items": { "type": "string" } },
        "wikiDraft": { "type": "object" }
      }
    }
  }
}
