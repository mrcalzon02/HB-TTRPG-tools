{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/kaysender/schemas/wiki-entry.schema.json",
  "title": "Kaysender Wiki Entry",
  "type": "object",
  "required": ["id", "title", "category", "summary", "body", "tags", "relatedEntries", "relatedModules"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug used for wiki links and cross-linking."
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "World, Regions, Nations, Factions, Ships, Economy, Creatures, GM Tools, Rules, or other future category."
    },
    "summary": {
      "type": "string",
      "description": "Reader-facing summary. This must not replace the full source-derived body."
    },
    "body": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Reader-facing lore paragraphs. Internal wiki hotlinks use [[entry-id|visible text]]. Do not reduce source material to only a digest; preserve the full lore substance in body/sections or source chunks."
    },
    "sections": {
      "type": "array",
      "description": "Optional titled sections for deeper wiki entries. Sections should preserve source lore first; builder/editor sections should be separated from reader-facing lore.",
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string" },
          "body": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sectionType": {
            "type": "string",
            "enum": ["lore", "history", "culture", "geography", "economy", "faction", "creature", "mechanics-legacy", "conversion-note", "builder-note"],
            "description": "Optional classification. Default visible sections should be lore-facing."
          },
          "sourceRefs": {
            "type": "array",
            "items": { "$ref": "#/$defs/sourceRef" }
          }
        },
        "additionalProperties": false
      }
    },
    "statBlocks": {
      "type": "array",
      "description": "Optional Hypertext d20-compatible statistics blocks. Lore entries that describe creatures, hazards, vehicles, factions, settlements, or important equipment can carry converted stat blocks here rather than leaving mechanics as prose placeholders.",
      "items": { "$ref": "#/$defs/statBlock" }
    },
    "sourceStatus": {
      "type": "string",
      "enum": ["seed-summary", "partial-source", "source-faithful", "full-source-import", "derived-tool-output"],
      "description": "Shows whether this entry is only a stub, partially imported, source-faithful, fully imported, or generated from a tool."
    },
    "sourceRefs": {
      "type": "array",
      "description": "Hard references to source document pages, outline sections, or extracted source chunks. Generators should use entries with sourceRefs where possible.",
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "sourceChunkIds": {
      "type": "array",
      "description": "Optional IDs of raw or near-raw source chunks that this wiki entry incorporates.",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedEntries": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Wiki entry ids."
    },
    "relatedModules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Registry module ids."
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string" },
        "fileName": { "type": "string" },
        "pageStart": { "type": "integer", "minimum": 1 },
        "pageEnd": { "type": "integer", "minimum": 1 },
        "outlineTitle": { "type": "string" },
        "chunkId": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "statBlock": {
      "type": "object",
      "required": ["id", "title", "ruleset", "conversionStatus", "statType", "challengeRating", "hitDice", "initiative", "armorClass", "speed", "saves", "abilities"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "ruleset": { "type": "string", "description": "Example: Hypertext d20 compatible." },
        "conversionStatus": { "type": "string", "enum": ["converted-hypertext-d20", "draft-conversion", "legacy-source", "needs-review"] },
        "statType": { "type": "string", "enum": ["creature", "hazard", "vehicle", "settlement", "faction", "item", "template", "other"] },
        "creatureType": { "type": "string" },
        "size": { "type": "string" },
        "alignment": { "type": "string" },
        "challengeRating": { "type": "string" },
        "experience": { "type": "string" },
        "hitDice": { "type": "string" },
        "hitPoints": { "type": "string" },
        "initiative": { "type": "string" },
        "speed": { "type": "array", "items": { "type": "string" } },
        "armorClass": {
          "type": "object",
          "properties": {
            "total": { "type": "string" },
            "touch": { "type": "string" },
            "flatFooted": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "baseAttackGrapple": { "type": "string" },
        "attack": { "type": "string" },
        "fullAttack": { "type": "string" },
        "spaceReach": { "type": "string" },
        "specialAttacks": { "type": "array", "items": { "type": "string" } },
        "specialQualities": { "type": "array", "items": { "type": "string" } },
        "saves": {
          "type": "object",
          "properties": {
            "fortitude": { "type": "string" },
            "reflex": { "type": "string" },
            "will": { "type": "string" }
          },
          "additionalProperties": false
        },
        "abilities": {
          "type": "object",
          "properties": {
            "strength": { "type": "string" },
            "dexterity": { "type": "string" },
            "constitution": { "type": "string" },
            "intelligence": { "type": "string" },
            "wisdom": { "type": "string" },
            "charisma": { "type": "string" }
          },
          "additionalProperties": false
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "feats": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "string" },
        "organization": { "type": "string" },
        "treasure": { "type": "string" },
        "advancement": { "type": "string" },
        "levelAdjustment": { "type": "string" },
        "tactics": { "type": "array", "items": { "type": "string" } },
        "conversionNotes": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
