{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/data/kaysender/schemas/crafting-project.schema.json",
  "title": "Kaysender Crafting Project",
  "type": "object",
  "required": [
    "id",
    "name",
    "ruleset",
    "templateId",
    "mode",
    "category",
    "scale",
    "quality",
    "complexity",
    "projectDC",
    "workUnits",
    "marketPrice",
    "rawMaterialCost",
    "primaryConstructionSkill",
    "researchSkill",
    "testingSkill",
    "activation",
    "effect",
    "materials",
    "powerSource",
    "maintenance",
    "restrictions",
    "legalStatus"
  ],
  "properties": {
    "id": {"type":"string"},
    "name": {"type":"string"},
    "manufacturer": {"type":"string"},
    "ruleset": {"type":"string","const":"Hypertext d20 compatible"},
    "generatorStatus": {"type":"string"},
    "templateId": {"type":"string"},
    "mode": {"type":"string","enum":["personal-equipment","weapon-armor","ship-module","ship-weapon","ship-core"]},
    "category": {"type":"string"},
    "scale": {"type":"string"},
    "slotUse": {"type":"string"},
    "quality": {"type":"string"},
    "complexity": {"type":"string","enum":["Routine","Standard","Complex","Advanced","Revolutionary"]},
    "projectDC": {"type":"integer","minimum":10,"maximum":40},
    "minimumRecommendedLevel": {"type":"integer","minimum":1,"maximum":20},
    "workUnits": {"type":"integer","minimum":1},
    "plannedWorkDays": {"type":"integer","minimum":1},
    "qualifiedPrimaryCrafters": {"type":"integer","minimum":1},
    "marketPrice": {"type":"number","minimum":0},
    "rawMaterialCost": {"type":"number","minimum":0},
    "weightPounds": {"type":"number","minimum":0},
    "primaryConstructionSkill": {"type":"string"},
    "researchSkill": {"type":"string"},
    "testingSkill": {"type":"string"},
    "facility": {"type":"string"},
    "facilityModifier": {"type":"integer"},
    "qualityBuildModifier": {"type":"integer"},
    "activation": {"type":"string"},
    "effect": {"type":"string"},
    "materials": {"type":"string"},
    "materialTags": {"type":"array","items":{"type":"string"}},
    "powerSource": {"type":"string"},
    "powerMaintenance": {"type":"string"},
    "maintenance": {"type":"string"},
    "restrictions": {"type":"string"},
    "legalStatus": {"type":"string"},
    "plannedImprovements": {"type":"array","items":{"type":"string"}},
    "potentialMinorFlaws": {"type":"array","items":{"type":"string"}},
    "potentialMajorFlaws": {"type":"array","items":{"type":"string"}},
    "projectComplication": {"type":"string"},
    "constructionAssumptions": {
      "type":"object",
      "properties": {
        "crafterSkillBonus":{"type":"number"},
        "aidAnotherBonus":{"type":"number"},
        "qualityModifier":{"type":"number"},
        "facilityModifier":{"type":"number"}
      },
      "additionalProperties": false
    },
    "simulation": {
      "type":"object",
      "properties": {
        "completedSuccessfully":{"type":"boolean"},
        "research":{"type":"object"},
        "construction":{"type":"object"},
        "testing":{"type":"object"},
        "minorFlaws":{"type":"array","items":{"type":"string"}},
        "majorFlaws":{"type":"array","items":{"type":"string"}},
        "finalMaterialCost":{"type":"number","minimum":0},
        "result":{"type":"string"}
      },
      "additionalProperties": true
    },
    "wikiDraft": {"type":"object"}
  },
  "additionalProperties": true
}