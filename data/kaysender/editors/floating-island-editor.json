  "outputTemplates": {
    "summary": "{name} is a {sizeClass} serving as a {islandRole}. It sits in the {altitudeBand}, with {stabilityClass} stability, {driftPattern}, and {anchorStatus}. Its terrain is defined by {terrainCore}. Water access is {waterProfile}; food support is {foodProfile}; the main valuable resource is {primaryResource}.",
    "gmNoteTemplates": [
      "Treat this island as a {islandRole} with {factionPressure}; the island's immediate clock is that {threatClock}.",
      "The dominant adaptation style is {culturalAdaptation}, which should influence architecture, NPC attitudes, repair methods, and crisis response.",
      "Route access is {routeAccess}; any airship approach should reflect this in costs, delays, pilot requirements, or encounter risk.",
      "Ecology pressure is {ecologyPressure}; use this to seed encounters, materials, disease risk, local taboos, or trade goods."
    ],
    "settlementHooks": [
      "The settlement footprint is {settlementFootprint}; decide who controls landing rights, water access, and emergency shelters.",
      "If the island remains inhabited, its leaders must solve {waterProfile}, {foodProfile}, and {threatClock} before the next route cycle.",
      "The island's construction style should reflect {culturalAdaptation} and {anchorStatus}."
    ],
    "routeHooks": [
      "Route charts should flag this location as {routeAccess} with {driftPattern}.",
      "Airship captains care about this island because of {primaryResource}, {waterProfile}, and its role as {islandRole}.",
      "The next route complication should involve {threatClock}."
    ],
    "marketHooks": [
      "Market pressure should center on {primaryResource}, {waterProfile}, and {foodProfile}.",
      "If traders arrive, the first dispute should involve {factionPressure} or control of docking access.",
      "Scarcity pricing should increase if {routeAccess} or {threatClock} worsen."
    ],
    "encounterHooks": [
      "An encounter can begin when {threatClock}. The opposition may be tied to {factionPressure}.",
      "Use {ecologyPressure} to create a non-humanoid pressure before adding pirates, dragons, or guild agents.",
      "The terrain encounter map should emphasize {terrainCore}, {altitudeBand}, and the consequences of {stabilityClass}."
    ]
  }
