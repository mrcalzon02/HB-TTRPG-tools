{
  "id": "floating-island-editor",
  "title": "Floating Island / Skyland Foundation Editor",
  "stage": 1,
  "status": "foundation-alpha",
  "purpose": "Create a quantitative, mappable floating-landmass foundation with exact dimensions, composition, motion, settlement viability, ecology, resources, and reserved adventure-site capacity.",
  "sourceThemes": [
    "Floating landmasses range from loose floatstone debris to minor floating subcontinents.",
    "Horizontal position, average altitude, vertical oscillation, fracture risk, and route reliability are separate characteristics.",
    "Flat fertile ground is valuable only when stability, water, altitude behavior, and access allow sustained use.",
    "Unreliable position or altitude can reduce settlement value while increasing concealment and criminal utility.",
    "A useful generated island must provide measurable room for settlements, dungeons, wilderness sites, resources, lairs, loot, and future adventures."
  ],
  "controls": [
    {"id":"name","label":"Island Name","type":"text","default":"Unnamed Skyland"},
    {"id":"sizeClass","label":"Landmass Size Class","type":"select","default":"village island","options":["loose floatstone ore cluster","debris raft","rocklet","small isle","village island","township island","fortress island","city-bearing island","regional island","minor floating subcontinent"]},
    {"id":"shapeProfile","label":"Overall Shape","type":"select","default":"irregular oval","options":["loose cluster","narrow shard","irregular oval","broad tabular plateau","crescent shelf","split twin-mass","terraced cone","ring island","long ridge","fractured archipelago"]},
    {"id":"lengthKm","label":"Maximum Length (km)","type":"number","default":4,"min":0.05,"max":900,"step":0.05},
    {"id":"widthKm","label":"Maximum Width (km)","type":"number","default":2.5,"min":0.05,"max":600,"step":0.05},
    {"id":"meanThicknessM","label":"Mean Thickness (m)","type":"number","default":180,"min":2,"max":12000,"step":1},
    {"id":"usableSurfacePercent","label":"Usable Surface (%)","type":"number","default":62,"min":0,"max":100,"step":1},
    {"id":"flatlandPercent","label":"Flat or Gently Sloped Surface (%)","type":"number","default":38,"min":0,"max":100,"step":1},
    {"id":"arableSoilPercent","label":"Arable Soil within Usable Surface (%)","type":"number","default":34,"min":0,"max":100,"step":1},
    {"id":"baseRockPercent","label":"Ordinary Rock (%)","type":"number","default":45,"min":0,"max":100,"step":1},
    {"id":"floatstonePercent","label":"Floatstone-bearing Material (%)","type":"number","default":30,"min":0,"max":100,"step":1},
    {"id":"soilPercent","label":"Soil and Sediment (%)","type":"number","default":15,"min":0,"max":100,"step":1},
    {"id":"cavernVoidPercent","label":"Caverns and Internal Voids (%)","type":"number","default":10,"min":0,"max":80,"step":1},
    {"id":"structuralIntegrity","label":"Structural Integrity","type":"select","default":"stable with local faults","options":["loose unbound fragments","actively crumbling","fracture-prone","seasonally stressed","stable with local faults","geologically stable","exceptionally coherent","artificially reinforced"]},
    {"id":"fractureRate","label":"Estimated Surface Loss per Century (%)","type":"number","default":1.5,"min":0,"max":100,"step":0.1},
    {"id":"meanAltitudeM","label":"Mean Altitude above Reference Layer (m)","type":"number","default":3200,"min":-5000,"max":50000,"step":50},
    {"id":"verticalOscillationM","label":"Vertical Oscillation Range ± (m)","type":"number","default":80,"min":0,"max":10000,"step":10},
    {"id":"oscillationPeriodHours","label":"Vertical Oscillation Period (hours)","type":"number","default":36,"min":0.25,"max":8760,"step":0.25},
    {"id":"altitudePredictability","label":"Altitude Predictability","type":"select","default":"predictable cycle","options":["fixed altitude","predictable cycle","seasonally predictable","weather-sensitive","irregular oscillation","violent altitude surges","unknown pattern"]},
    {"id":"horizontalDriftKpd","label":"Average Horizontal Drift (km/day)","type":"number","default":2,"min":0,"max":500,"step":0.1},
    {"id":"driftPredictability","label":"Horizontal Drift Predictability","type":"select","default":"charted seasonal route","options":["fixed relative position","precisely charted drift","charted seasonal route","weather-dependent route","loosely predictable wandering","erratic wandering","frequent course reversal","unknown external pull"]},
    {"id":"nearestCivilizationKm","label":"Distance to Nearest Civilization (km)","type":"number","default":180,"min":0,"max":20000,"step":5},
    {"id":"routeTraffic","label":"Nearby Route Traffic","type":"select","default":"occasional traffic","options":["major established route","regular regional traffic","occasional traffic","rare survey traffic","uncharted frontier","deliberately avoided region","secret or criminal corridor"]},
    {"id":"chartQuality","label":"Current Chart Reliability","type":"select","default":"usable with corrections","options":["survey-grade coordinates","reliable seasonal charts","usable with corrections","outdated charts","contradictory reports","rumor only","deliberately falsified"]},
    {"id":"approachProfile","label":"Approach and Landing","type":"select","default":"two reliable approaches","options":["many safe approaches","two reliable approaches","one narrow approach","requires local pilot","storm-shear approach","no natural landing shelf","underside access only","moving rendezvous required"]},
    {"id":"waterProfile","label":"Water Availability","type":"select","default":"rain capture and small springs","options":["none","seasonal rain only","rain capture and small springs","reliable spring network","lake or deep reservoir","abundant river system","tainted water system","magically sustained water","import dependent"]},
    {"id":"annualRainfallMm","label":"Annual Rainfall Equivalent (mm)","type":"number","default":780,"min":0,"max":12000,"step":10},
    {"id":"primaryTerrain","label":"Primary Surface Terrain","type":"select","default":"mixed plateau and ridges","options":["bare floatstone debris","broken cliffs","mixed plateau and ridges","broad arable plateau","terraced hills","forest canopy","fungal cloud forest","arid scrub","wetland basins","ruined urban surface","mining scarlands","glacial surface"]},
    {"id":"secondaryTerrain","label":"Secondary Terrain","type":"select","default":"wind-cut ravines","options":["none","wind-cut ravines","cliff shelves","sinkholes and caverns","old ruins","forest belts","pasture","crystal gullies","river valleys","wreck fields","volcanic vents","unstable edge fields"]},
    {"id":"mineralPresence","label":"Mineral Presence","type":"select","default":"mixed useful deposits","options":["negligible","common stone only","mixed useful deposits","rich iron and base metals","precious-metal veins","floatstone ore concentration","crystal and arcane mineral field","industrial salts and alchemical minerals","ancient worked mine network"]},
    {"id":"mineralAccessibility","label":"Mineral Accessibility","type":"select","default":"requires ordinary mining","options":["surface exposed","shallow quarrying","requires ordinary mining","deep and dangerous","inside unstable underside","contested by wildlife","sealed behind ruins"]},
    {"id":"vegetationCoverPercent","label":"Vegetation Cover (%)","type":"number","default":48,"min":0,"max":100,"step":1},
    {"id":"wildlifeDensity","label":"Wildlife Density","type":"select","default":"established ecosystem","options":["nearly sterile","sparse pioneer species","limited ecosystem","established ecosystem","rich biodiversity","overcrowded migration stop","apex-predator dominated","magically unstable ecology"]},
    {"id":"dominantWildlife","label":"Dominant Wildlife","type":"select","default":"mixed small sky fauna","options":["none","Gray blooms and plankton","mixed small sky fauna","sheffel-compatible grazers","large herd animals","predatory flyers","skywhale-associated ecology","burrowing cavern fauna","ruin-adapted creatures","magical weather entities"]},
    {"id":"existingPopulation","label":"Existing Permanent Population","type":"number","default":850,"min":0,"max":5000000,"step":1},
    {"id":"currentUse","label":"Current Primary Use","type":"select","default":"frontier settlement","options":["unclaimed wilderness","frontier settlement","agricultural colony","mining claim","trade waypoint","military position","religious sanctuary","criminal hideout","pirate harbor","ruin expedition base","wildlife preserve","abandoned disaster site"]},
    {"id":"knownDungeonCount","label":"Known Dungeon or Ruin Sites","type":"number","default":2,"min":0,"max":500,"step":1},
    {"id":"hiddenSiteDensity","label":"Hidden Site Density","type":"select","default":"several plausible sites","options":["none expected","one isolated secret","several plausible sites","dense layered history","ruin-saturated landscape","mostly unexplored"]},
    {"id":"mapGridScale","label":"Foundation Map Grid","type":"select","default":"12 x 8 regional cells","options":["6 x 4 coarse cells","8 x 6 standard cells","12 x 8 regional cells","16 x 12 detailed cells","24 x 16 campaign cells"]}
  ],
