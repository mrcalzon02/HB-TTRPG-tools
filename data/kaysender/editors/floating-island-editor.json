{
  "id": "floating-island-editor",
  "title": "Floating Island / Skyland Editor",
  "stage": 1,
  "status": "editor-alpha",
  "purpose": "Create a detailed Kaysender skyland profile that can feed settlements, routes, markets, airships, ecology, factions, encounters, and wiki entries.",
  "sourceThemes": [
    "Floating continents, islands, and landmasses drift unpredictably and can separate settlements or destroy routes.",
    "Natural water is scarce in the open sky; rain capture, cloud dew, cisterns, magical storage, and water trade matter.",
    "Sky ecology includes creatures, materials, magical oils, rare feathers, predators, herds, and disease risk.",
    "Different peoples adapt to instability through fortification, mobility, magic, engineering, trade networks, or survival craft.",
    "Settlements must be judged by stability, water, food, route access, defense, faction pressure, and crisis state."
  ],
  "controls": [
    {
      "id": "name",
      "label": "Island Name",
      "type": "text",
      "default": "Unnamed Skyland"
    },
    {
      "id": "islandRole",
      "label": "Primary Role",
      "type": "select",
      "default": "frontier settlement base",
      "options": [
        "frontier settlement base",
        "water source island",
        "trade-route waypoint",
        "ruined city fragment",
        "dragon tithe holding",
        "pirate hideout",
        "guild survey claim",
        "skybeast nesting ground",
        "mining and quarry island",
        "pilgrimage refuge",
        "military watch island",
        "abandoned disaster site"
      ]
    },
    {
      "id": "sizeClass",
      "label": "Size Class",
      "type": "select",
      "default": "village-scale island",
      "options": [
        "tiny rocklet",
        "small pasture isle",
        "village-scale island",
        "township island",
        "fortress island",
        "city-bearing island",
        "large regional island",
        "minor floating continent"
      ]
    },
    {
      "id": "altitudeBand",
      "label": "Altitude Band",
      "type": "select",
      "default": "trade-wind layer",
      "options": [
        "low mist belt",
        "trade-wind layer",
        "storm edge",
        "high bright air",
        "dragon-route altitude",
        "abyss-shadowed undercurrent"
      ]
    },
    {
      "id": "stabilityClass",
      "label": "Stability",
      "type": "select",
      "default": "mostly stable",
      "options": [
        "actively crumbling",
        "fracture-prone",
        "seasonally unstable",
        "mostly stable",
        "anchored by old magic",
        "engineered stabilization",
        "geologically stubborn"
      ]
    },
    {
      "id": "driftPattern",
      "label": "Drift Pattern",
      "type": "select",
      "default": "slow predictable drift",
      "options": [
        "fixed relative position",
        "slow predictable drift",
        "seasonal migration",
        "storm-driven drift",
        "erratic wandering",
        "split-chain drift",
        "recently detached",
        "being pulled by unknown force"
