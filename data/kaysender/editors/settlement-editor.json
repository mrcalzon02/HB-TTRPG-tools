{
  "id": "settlement-editor",
  "title": "Settlement / Skyport Editor",
  "stage": 2,
  "status": "editor-alpha",
  "purpose": "Create a detailed Kaysender settlement profile that can consume island pressure and output civic structure, scarcity, defenses, markets, factions, jobs, crisis clocks, and wiki-ready settlement records.",
  "sourceThemes": [
    "Settlements in Kaysender survive inside unstable geography, shifting trade access, food and water scarcity, and unpredictable sky routes.",
    "Small sky settlements may be agricultural hubs, fortified villages, guild camps, dragon-tithed communities, pirate refuges, or neutral-ground trade stops.",
    "Dunhallow Roost demonstrates a useful settlement model: small population, agricultural output, weak militia, trade dependence, draconic tithe pressure, and tavern-centered faction observation.",
    "Population, defenses, leadership, economy, water, food, faction pressure, and crisis state should be generated together because none of them exist separately in a skyborne survival settlement.",
    "Cultural adaptation should affect civic architecture, emergency planning, defenses, water handling, food security, trade customs, and settlement morale."
  ],
  "controls": [
    { "id": "name", "label": "Settlement Name", "type": "text", "default": "Unnamed Skyport" },
    {
      "id": "settlementType",
      "label": "Settlement Type",
      "type": "select",
      "default": "small fortified village",
      "options": [
        "temporary sky camp",
        "small fortified village",
        "agricultural island town",
        "minor skyport",
        "guild extraction camp",
        "dragon-tithed hamlet",
        "pilgrim refuge",
