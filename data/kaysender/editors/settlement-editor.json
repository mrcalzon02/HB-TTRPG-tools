  "outputTemplates": {
    "summary": "{name} is a {settlementType} with a {populationScale} population. It is governed by {governmentType}, defended by {defensePosture}, and sustained by {economyBase}. Water status is {waterStatus}; food status is {foodStatus}; trade access is {tradeAccess}.",
    "gmNoteTemplates": [
      "The current crisis clock is: {crisisClock}. This should be visible in rumors, prices, guard behavior, and job availability.",
      "Faction presence is {factionPresence}; use this to decide who watches the docks, controls information, or profits from scarcity.",
      "The settlement's most important civic asset is {civicAsset}. Put scenes there early.",
      "Local secret: {localSecret}. This should complicate at least one job, market scene, or negotiation."
    ],
    "leadershipHooks": [
      "Leadership authority comes from {governmentType}, but social stress is currently {socialStress}.",
      "The leader's first public problem is {crisisClock}; their private problem is {localSecret}.",
      "If the players help, leadership offers access to {civicAsset} or restricted trade information."
    ],
    "marketHooks": [
      "Market prices should react to {waterStatus}, {foodStatus}, and {tradeAccess}.",
      "The main export or trade leverage is {economyBase}; the main market distortion is {socialStress}.",
      "A shopkeeper knows about {localSecret}, but will only talk if the party addresses {crisisClock}."
    ],
    "factionHooks": [
      "The most visible outside pressure is {factionPresence}.",
      "A faction representative wants control over {civicAsset} because of {economyBase}.",
      "The crisis clock gives {factionPresence} an excuse to expand influence."
    ],
    "defenseHooks": [
      "Defenses are defined by {defensePosture}; test them against {crisisClock}.",
      "If violence erupts, the first defensive failure should involve {tradeAccess}, {civicAsset}, or the water supply.",
      "The militia, guards, or enforcers are politically tied to {governmentType}."
    ],
    "jobHooks": [
      "Recover or protect the settlement's access to {waterStatus} before the crisis clock worsens.",
      "Investigate {localSecret} while {factionPresence} watches from the edges of town.",
      "Escort or repair trade access because the settlement relies on {economyBase}.",
      "Resolve {socialStress} before it turns the population against {governmentType}."
    ]
  }
