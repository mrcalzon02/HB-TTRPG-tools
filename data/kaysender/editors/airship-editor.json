  "outputTemplates": {
    "summary": "{name} is a {vesselClass} with a {hullCulture}, powered by a {coreType}. It currently serves as {purpose}, carries {cargoProfile}, operates under {legalStatus}, and is commanded by a {captainStyle}.",
    "technicalNotes": [
      "Core and hull are the heart of this vessel: {coreType} inside a {hullCulture}. Let this shape repairs, crew requirements, cost, and cultural politics.",
      "Condition is {condition}; maintenance pressure is {maintenancePressure}; fuel or power status is {fuelSupply}.",
      "Route compatibility is {routeAccess}. A ship that cannot safely match the route should create delay, repair, pilot, or escort complications."
    ],
    "crewHooks": [
      "Crew quality is {crewQuality}; crew scale is {crewScale}; morale is {moraleState}.",
      "The captain is a {captainStyle}; their command style should affect discipline, route risk, and faction negotiations.",
      "A crew scene should expose the hidden problem: {hiddenProblem}."
    ],
    "cargoHooks": [
      "The cargo profile is {cargoProfile}; its value, legality, spoilage, weight, or political importance should affect the mission.",
      "Cargo pressure should interact with {fuelSupply}, {routeMandate}, and {portOfCall}.",
      "If the cargo is threatened, the crew must choose between mission success, ship survival, and faction obligations."
    ],
    "routeHooks": [
      "The current route mandate is to {routeMandate}.",
      "The ship's route compatibility is {routeAccess}; the destination pressure is {portOfCall}.",
      "Route scenes should test weather, charts, pilots, fuel, crew morale, and whether the vessel class can survive the chosen altitude and hazard band."
    ],
    "factionHooks": [
      "Faction entanglement: {factionEntanglement}.",
      "Legal status is {legalStatus}; this determines whether port officials, pirates, guilds, dragons, or navies can pressure the crew.",
      "A faction agent should know about {hiddenProblem} and use it to force a concession."
    ],
    "maintenanceHooks": [
      "Maintenance pressure is {maintenancePressure}; the ship needs parts, ritual labor, specialists, tools, drydock time, or secrecy.",
      "Fuel or power supply is {fuelSupply}; this should create countdown pressure if the route is long or hostile.",
      "A failed maintenance scene should expose the unique weakness of the {coreType}."
    ],
    "encounterHooks": [
      "Start with the mission: {currentMission}. Then complicate it with {hiddenProblem}.",
      "Combat, negotiation, or chase scenes should use {armament}, {defenseSystem}, and {routeAccess}.",
      "The ship's port of call is {portOfCall}; make arrival politically useful, dangerous, or expensive."
    ]
  }
