    {
      "id": "duplicate-cell-id",
      "description": "Two map cells use the same stable ID.",
      "mutation": {
        "operation": "replace",
        "path": "/map/cells/1/id",
        "value": "cell-western-port"
      },
      "expectedDiagnostics": [
        {
          "severity": "error",
          "code": "duplicate-entity-id",
          "path": "map.cells[1].id"
        }
      ]
    },
    {
      "id": "active-cell-reference-missing",
      "description": "The active cell list references a cell that does not exist.",
      "mutation": {
        "operation": "add",
        "path": "/map/activeCellIds/-",
        "value": "cell-missing-southern-shelf"
      },
      "expectedDiagnostics": [
        {
          "severity": "error",
          "code": "broken-cell-reference",
          "path": "map.activeCellIds"
        }
      ]
    },
    {
      "id": "site-cell-reference-missing",
