                    {
                        "id":  "emberforge-alchemists",
                        "title":  "Emberforge Alchemists",
                        "category":  "Factions",
                        "summary":  "Fire-alchemists produce volatile strength serums and incendiary oils for warriors and demolitionists.",
                        "body":  [
                                     "Blazing Fury Serum combines flame orchids, ember powder, molten steel, and heat-resistant packaging. Ignition Oil is mixed through controlled combustion and stored in impact-breaking flasks.",
                                     "Their products smell of chili, smoke, sulfur, and burning wood and demand careful transport."
                                 ],
                        "sections":  [
                                         {
                                             "heading":  "Legacy Potions",
                                             "sectionType":  "mechanics-legacy",
                                             "body":  [
                                                          "Strength, resistance, duration, and fire-damage values require conversion."
                                                      ]
                                         }
                                     ],
