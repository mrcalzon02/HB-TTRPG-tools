                    {
                        "id":  "verdant-circle-collective",
                        "title":  "Verdant Circle Collective",
                        "category":  "Factions",
                        "summary":  "Sustainable herbalists serve druids, rangers, and naturalists with restorative and animal-affinity brews.",
                        "body":  [
                                     "The Collective uses sun-dried herbs, spring water, growth charms, enchanted sap, berries, pheromones, wooden barrels, recycled glass, biodegradable twine, clay, and beeswax.",
                                     "Its Verdant Restoration Draught evokes mint and dew-covered grass; Beastbinder\u0027s Tonic smells of berries and forest moss."
                                 ],
                        "sections":  [
                                         {
                                             "heading":  "Legacy Potions",
                                             "sectionType":  "mechanics-legacy",
                                             "body":  [
                                                          "Healing and animal-handling bonuses require conversion."
                                                      ]
                                         }
                                     ],
