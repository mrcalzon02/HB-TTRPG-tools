                    {
                        "id":  "gilded-flask-guild",
                        "title":  "The Gilded Flask Guild",
                        "category":  "Factions",
                        "summary":  "Luxury alchemists sell potent, lavishly packaged restoratives and confidence tonics to nobles, wealthy merchants, and adventurers.",
                        "body":  [
                                     "The Gilded Flask uses rare herbs, celestial honey, crystal basins, moonlight aging, amber spirits, and warming charms. Its Elixir of Vital Resurgence tastes of honey and citrus, while Liquid Courage resembles spiced apple by a winter hearth.",
                                     "Gold filigree, gilded corks, wax seals, and lion emblems make its products recognizable status goods as well as medicine."
                                 ],
                        "sections":  [
                                         {
                                             "heading":  "Legacy Potions",
                                             "sectionType":  "mechanics-legacy",
                                             "body":  [
                                                          "The source gives healing, exhaustion, fear, Charisma, and duration values for its potions. Conversion is required."
                                                      ]
                                         }
                                     ],
                        "sourceStatus":  "source-faithful",
