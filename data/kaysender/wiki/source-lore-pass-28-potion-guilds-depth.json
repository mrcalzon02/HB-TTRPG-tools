                    {
                        "id":  "iron-cauldron-consortium",
                        "title":  "Iron Cauldron Consortium",
                        "category":  "Factions",
                        "summary":  "A practical potion supplier produces affordable, durable brews for soldiers, adventurers, and ordinary workers.",
                        "body":  [
                                     "The Consortium boils roots, iron filings, and volcanic ash in cast-iron cauldrons for Ironhide Tonic. Fleetfoot Brew uses windblossom and quicksilver, rapidly infused and cooled in running water.",
                                     "Riveted iron flasks and blackened steel lightning vials emphasize durability over display."
                                 ],
                        "sections":  [
                                         {
                                             "heading":  "Legacy Potions",
                                             "sectionType":  "mechanics-legacy",
                                             "body":  [
                                                          "Armor, speed, agility, and duration values require conversion."
                                                      ]
                                         }
                                     ],
