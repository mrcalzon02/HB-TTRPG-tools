{
  "schema": "beckenburg.npc-ai-authoring/v1",
  "updated": "2026-10-30",
  "title": "Modular NPC/AI automation and canonical ghost behavior introspection",
  "target": {
    "runtime": "Java 17 modern PSX-styled Beckenburg",
    "portablePackage": "org.beckenburg.editor.ai",
    "gameAdapter": "org.beckenburg.GhostAiRuleAdapter",
    "ui": "org.beckenburg.GhostAiRuleLab",
    "editorCommand": "NPC / AI",
    "mode": "read-only developer inspection; not live ghost control"
  },
  "sources": [
    {
      "path": "src/main/java/org/beckenburg/GhostIdentity.java",
      "read": [
        "roster",
        "variant inheritance",
        "rite",
        "behavior"
      ]
    },
    {
      "path": "src/main/java/org/beckenburg/GhostTraits.java",
      "read": [
        "locomotion",
        "passage",
        "sight",
        "charge",
        "speed",
        "UV",
        "solitary"
      ]
    },
    {
      "path": "src/main/java/org/beckenburg/GhostBehavior.java",
      "read": [
        "favored action",
        "AI period",
        "tells"
      ]
    },
    {
      "path": "src/main/java/org/beckenburg/GhostFrenzy.java",
      "read": [
        "cost",
        "earliest tick",
        "physical vs dread attacks"
      ]
    },
    {
      "path": "src/main/java/org/beckenburg/GhostEvidenceMatrix.java",
      "read": [
        "possible evidence, not confirmed evidence"
      ]
    },
    {
      "path": "src/main/java/org/beckenburg/GhostDomain.java",
      "read": [
        "legal actions",
        "exits",
        "coarse host observation"
      ]
    },
    {
      "path": "docs/ai/PSX_NPC_AI_ADOPTION.md",
      "read": [
        "performance-safe adaptation and host fairness"
      ]
    }
  ],
  "portable": [
    {
      "type": "NpcRuleBook",
      "features": [
        "immutable typed contracts",
        "duplicate rejection",
        "base variant validation",
        "readable explanations",
        "non-blocking findings"
      ]
    },
    {
      "type": "NpcDecisionWorkbench",
      "features": [
        "read-only legal action check",
        "real exit validation",
        "spatial victim guard",
        "bounded deterministic replay"
      ],
      "maxReplayObservations": 512
    },
    {
      "type": "NpcRuleExport",
      "features": [
        "sorted canonical species snapshot",
        "escaped deterministic JSON",
        "atomic source-only file export",
        "diagnostics as data"
      ]
    }
  ],
  "uiCapabilities": [
    "all registered base/Ancient/Elder ghost types",
    "actual live-source trait reading",
    "isolated GhostDomain sandbox at 10Hz",
    "coarse legal-action and energy inspection",
    "action reasoning without dispatch",
    "Audit roster and export machine-readable live-source behavior rules"
  ],
  "authoritativeBoundaries": [
    "Only GhostDomain.dispatch may change energy, cooldowns, fear, harm or manifestation",
    "Only host simulation owns ghost world position and hearing events",
    "Actual pursuit and acoustics are not bypassed",
    "Host-strike spatial contact cannot be inferred from hearing alone",
    "Camera-only visibility and door/wall restrictions are enforced by game, not redefined in tool",
    "No player coordinates, private evidence, gear, health, or van secrets in portable observation",
    "No arbitrary imported script execution"
  ],
  "tests": [
    {
      "path": "src/test/java/org/beckenburg/editor/ai/NpcRuleWorkbenchTest.java",
      "workflow": ".github/workflows/standalone-editor-kit.yml",
      "checks": [
        "rulebook",
        "decision workbench",
        "bounded replay",
        "JSON rulebook export"
      ]
    },
    {
      "path": "src/test/java/org/beckenburg/GhostAiRuleAdapterTest.java",
      "workflow": ".github/workflows/focused-castle-repairs.yml",
      "gate": "diagnostic, continue-on-error"
    },
    {
      "path": "src/test/java/org/beckenburg/editor/ai/NpcAiTelemetryTest.java",
      "workflow": ".github/workflows/standalone-editor-kit.yml"
    },
    {
      "path": "src/test/java/org/beckenburg/GhostAiNavigationAuditTest.java",
      "workflow": ".github/workflows/focused-castle-repairs.yml",
      "gate": "nonblocking diagnostic"
    },
    {
      "path": "src/test/java/org/beckenburg/GhostAiScenarioRunnerTest.java",
      "workflow": ".github/workflows/focused-castle-repairs.yml",
      "gate": "nonblocking diagnostic"
    }
  ],
  "implemented": "source, game adapter, UI, standalone and integration tests; success subject to observed CI",
  "notYetImplemented": [
    "editable behaviors writing back to game rules",
    "actual FPS and route profiling",
    "NPC pursuit animation integration",
    "other hunter/ally NPC controller adapters",
    "playtest host-backed scenario runner",
    "host-performance CSV exists; live editor attachment to a running host remains future work",
    "portal and acoustic map auditing exists; 3D navigation gizmos and collision path visualization remain future work"
  ],
  "future": [
    {
      "id": "AI-1",
      "action": "readOnlyHostTelemetry",
      "acceptance": "measure p50/p95/p99, bounded counters, no private hunter data"
    },
    {
      "id": "AI-2",
      "action": "navigationGraphValidation",
      "acceptance": "door/stair/portal reachable with actual collision and no teleport"
    },
    {
      "id": "AI-3",
      "action": "seededHostScenarioRunner",
      "acceptance": "verify real energy/cadence/frenzy and AI/human parity"
    },
    {
      "id": "AI-4",
      "action": "separateNpcArchetypeAdapters",
      "acceptance": "hunter allies/other NPC use their own canonical behavior sources"
    }
  ],
  "releasePolicy": "Diagnostic AI style/performance findings never release-block; only objective broken build/launch/core gameplay and required multiplayer matter",
  "implementationCheckpoint": "2026-10-30 NPC/AI telemetry, navigation diagnostics and scenario replay, pending new CI completion",
  "telemetry": {
    "portableType": "org.beckenburg.editor.ai.NpcAiTelemetry",
    "reportType": "org.beckenburg.editor.ai.NpcAiTelemetryReport",
    "owner": "per-LanHost instance; shared with LanGhostPursuit",
    "optIn": "-Dbeckenburg.ai.profile=true on local JVM or trusted LanHost.enableAiDiagnostics(true)",
    "defaultEnabled": false,
    "rollingSamples": 256,
    "metrics": [
      "HOST_TICK",
      "PERCEPTION",
      "DECISION",
      "APPROACH",
      "HEARING",
      "ROUTE"
    ],
    "fields": [
      "calls",
      "minNs",
      "p50Ns",
      "p95Ns",
      "p99Ns",
      "maxNs",
      "meanNs"
    ],
    "privacy": "never records actor coordinates, hunter identity/health, equipment, journal, or any network packet",
    "read": [
      "LanHost.aiDiagnosticsSnapshot()",
      "LanHost.aiDiagnosticsCsv()"
    ],
    "export": "NpcAiTelemetryReport.save(path, snapshot)",
    "productionMeasurement": true,
    "notes": [
      "Actual Java wall-clock function timing, not GPU or full-cycle profiling.",
      "Aggregate CSV printed only to local stderr on profiled host close."
    ]
  },
  "navigation": {
    "gameAdapter": "org.beckenburg.GhostAiNavigationAudit",
    "inputSources": [
      "HouseMap.ghostExits",
      "LanAcoustics.cost"
    ],
    "uiAction": "NPC / AI -> AUDIT NAV",
    "sandbox": "fresh authored-site map, no active mission state access",
    "checks": [
      "directed portal links",
      "unreachable ghost rooms",
      "nonreciprocal exits",
      "acoustic edge losses",
      "no extraction route"
    ],
    "resultStatus": "diagnostic",
    "notYet": [
      "live editor viewport route overlay",
      "door crossing physics test",
      "multi-floor coverage beyond existing HouseMap rules"
    ]
  },
  "scenarios": {
    "gameAdapter": "org.beckenburg.GhostAiScenarioRunner",
    "uiAction": "NPC / AI -> PROFILE RULES",
    "maxTicks": 1800,
    "maxTraceEvents": 128,
    "seeded": true,
    "sources": [
      "GhostDomain",
      "GhostActionCadence",
      "LanGhostPursuit",
      "HouseMap",
      "LanAcoustics"
    ],
    "preconditions": [
      "synthetic sound at authored room 4 every 40 ticks (when enabled)",
      "never supplies physical strike victim"
    ],
    "notCovered": [
      "live LAN actor movement and pose",
      "frenzy",
      "wards",
      "physics collision",
      "real hunters",
      "client packet synchronization"
    ],
    "status": "code present, awaiting latest CI execution"
  },
  "humanGuides": [
    "docs/wiki/psx-npc-ai-authoring.md",
    "docs/wiki/psx-npc-ai-telemetry-navigation.md"
  ]
}
