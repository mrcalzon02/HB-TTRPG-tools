{
  "schemaVersion": "1.6.0",
  "description": "Expandable authoritative indexes and broader campaign/lore/operation-contract/Agent-Skills/personality/Charles gateway resources for HBFoundryAPI.",
  "operationContracts": {
    "getResource": {
      "call": "HBFoundryAPI.getResource(resourceId, options)",
      "arguments": [
        {
          "name": "resourceId",
          "type": "string",
          "required": true,
          "description": "Stable resource id from this registry or the capability manifest."
        },
        {
          "name": "options",
          "type": "object",
          "required": false,
          "fields": {
            "raw": {
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "Return raw text instead of JSON parsing when applicable."
            },
            "refresh": {
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "Force a reload instead of using the facade cache."
            }
          }
        }
      ],
      "returns": "Parsed JSON for json resources or text for non-json resources."
    },
    "expandResourceIndex": {
      "call": "HBFoundryAPI.expandResourceIndex(resourceId)",
      "arguments": [
        {
          "name": "resourceId",
          "type": "string",
          "required": true,
          "description": "Stable id of a resource that declares indexRules."
        }
      ],
      "returns": "Array of generated child descriptors containing stable derived id, parentId, title, workspace, kind, format, path, and tags."
    },
    "searchCollection": {
      "call": "HBFoundryAPI.searchCollection(resourceId, query, options)",
      "arguments": [
        {
          "name": "resourceId",
          "type": "string",
          "required": true,
          "description": "Stable id of an expandable indexed resource."
        },
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Case-insensitive literal search term. Must be non-empty."
        },
        {
          "name": "options",
          "type": "object",
          "required": false,
          "fields": {
            "maxResults": {
              "type": "integer",
              "required": false,
              "default": 80,
              "range": "1..500"
            },
            "includeErrors": {
              "type": "boolean",
              "required": false,
              "default": false,
              "description": "Include child retrieval errors as result records instead of silently skipping them."
            }
          }
        }
      ],
      "returns": "Search-hit records carrying child resource id/path and matching value excerpt."
    },
    "searchResources": {
      "call": "HBFoundryAPI.searchResources(query, options)",
      "arguments": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "description": "Case-insensitive literal search term. Must be non-empty."
        },
        {
          "name": "options",
          "type": "object",
          "required": false,
          "fields": {
            "workspace": {
              "type": "string",
              "required": false
            },
            "kind": {
              "type": "string",
              "required": false
            },
            "resourceQuery": {
              "type": "string",
              "required": false,
              "description": "Filter resource descriptors before content search."
            },
            "resourceIds": {
              "type": "array<string>",
              "required": false,
              "description": "Restrict search to specified top-level resource ids."
            },
            "maxResults": {
              "type": "integer",
              "required": false,
              "default": 40,
              "range": "1..200"
            },
            "includeErrors": {
              "type": "boolean",
              "required": false
            }
          }
        }
      ],
      "returns": "Search-hit records across registered top-level resources."
    }
  },
