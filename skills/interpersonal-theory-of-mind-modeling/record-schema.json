{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrcalzon02.github.io/HB-TTRPG-tools/skills/interpersonal-theory-of-mind-modeling/record-schema.json",
  "title": "Interpersonal Theory of Mind Record",
  "description": "Portable directional projection of theory-of-mind state derived from the authoritative Character Information System. This record does not replace the durable character ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "modelHolder",
    "targetActor",
    "context",
    "informationBoundary",
    "beliefClaims",
    "trustModel",
    "hypotheses",
    "evidenceLedger",
    "lastUpdated"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "modelHolder": {
      "$ref": "#/$defs/actorRef"
    },
    "targetActor": {
      "$ref": "#/$defs/actorRef"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "informationBoundary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/informationItem"
      }
    },
    "beliefClaims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "perceivedGoals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "perceivedConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "trustModel": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustClaim"
      }
    },
    "socialPosture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "expectedBehavior": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionalExpectation"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "evidenceLedger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "updateHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/update"
      }
    },
    "politicalPublicFigureMode": {
      "type": "boolean",
      "default": false
    },
    "lastUpdated": {
      "type": "string",
      "minLength": 1
    },
    "analysisMode": {
      "enum": [
        "relationship-state",
        "deterministic-text-pipeline"
      ]
    },
    "coreDynamicSummary": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Exactly two concise sentences when deterministic-text-pipeline mode is used."
    },
    "frameworkAssessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frameworkAssessment"
      }
    },
    "congruenceAssessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/congruenceAssessment"
      },
      "description": "Legacy-compatible generic congruence field. Prefer presentationCongruence plus modelAccuracy and predictiveCalibration for v1.2+ records."
    },
    "epistemicChain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epistemicNode"
      }
    },
    "reasoningFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reasoningFlag"
      }
    },
    "presentationCongruence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calibrationAssessment"
      }
    },
    "modelAccuracy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calibrationAssessment"
      }
    },
    "predictiveCalibration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predictionRecord"
      }
    },
    "mentalizationAssessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mentalizationAssessment"
      }
    },
    "roleFrames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roleFrame"
      }
    },
    "trustVector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustVectorItem"
      }
    },
    "choiceContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choiceContext"
      }
    },
    "thirdPartyModels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thirdPartyModel"
      }
    },
    "influenceTraces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/influenceTrace"
      }
    },
    "temporalSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporalSnapshot"
      }
    },
    "modelRepairEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelRepairEvent"
      }
    },
    "decisionPressureContexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionPressureContext"
      }
    },
    "adversarialDynamics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adversarialDynamic"
      }
    },
    "dependencyDynamics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyDynamic"
      }
    },
    "modelDecomposition": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelDecomposition"
      }
    },
    "modelLastMaterialUpdate": {
      "type": [
        "string",
        "null"
      ]
    },
    "staleModelRisk": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "informationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "accessClass"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "accessClass": {
          "enum": [
            "directly-observed",
            "directly-told",
            "institutionally-available",
            "trusted-report",
            "rumor",
            "analyst-only",
            "unknown"
          ]
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "epistemicClass",
        "confidence"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "epistemicClass": {
          "enum": [
            "known-by-model-holder",
            "believed-by-model-holder",
            "suspected-by-model-holder",
            "analyst-inference",
            "documented-public-fact"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "supportingEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disconfirmingEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trustClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "expectation",
        "confidence"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conditionalExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "expectedResponse",
        "confidence"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "expectedResponse": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "supportingEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disconfirmingEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "live",
            "weakened",
            "strengthened",
            "rejected",
            "unresolved"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidenceClass"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceClass": {
          "enum": [
            "direct-observation",
            "statement",
            "action",
            "institutional-record",
            "trusted-report",
            "rumor",
            "canon-event",
            "public-source",
            "self-report",
            "recorded-statement",
            "trusted-third-party-report",
            "memory",
            "privileged-memory-access",
            "telepathic-access",
            "dream-vision",
            "internalized-other",
            "narrator-established",
            "manipulated-evidence-environment",
            "unknown"
          ]
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "reliabilityNote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affectedClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolutionStatus": {
          "enum": [
            "unresolved",
            "context-dependent",
            "model-revised",
            "evidence-error"
          ]
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "change"
      ],
      "properties": {
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "frameworkAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworkId",
        "finding",
        "confidence"
      ],
      "properties": {
        "frameworkId": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "congruenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "observedExternalData",
        "hypothesizedInternalReality",
        "congruence",
        "confidence"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "observedExternalData": {
          "type": "string",
          "minLength": 1
        },
        "hypothesizedInternalReality": {
          "type": "string",
          "minLength": 1
        },
        "congruence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "frameworkAnchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "epistemicNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "level",
        "subjectActorId",
        "statement",
        "confidence"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "subjectActorId": {
          "type": "string",
          "minLength": 1
        },
        "targetActorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "parentNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertaintyNote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reasoningFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag",
        "finding",
        "confidence"
      ],
      "properties": {
        "flag": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternativeExplanations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "calibrationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "rating",
        "confidence"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "predictionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snapshotRef",
        "condition",
        "expectedResponse",
        "status",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "snapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "expectedResponse": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "partially-supported",
            "contradicted",
            "untested",
            "invalidated-by-context-change"
          ]
        },
        "outcomeEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mentalizationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "use",
        "confidence"
      ],
      "properties": {
        "quality": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "use": {
          "enum": [
            "supportive",
            "protective",
            "collaborative",
            "negotiated",
            "instrumental",
            "coercive",
            "exploitative",
            "adversarial",
            "mixed",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "roleFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "model",
        "confidence"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trustVectorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "rating",
        "confidence"
      ],
      "properties": {
        "domain": {
          "enum": [
            "truthfulness",
            "bargain-keeping",
            "competence",
            "confidentiality",
            "loyalty",
            "affection-care",
            "predictability-under-pressure",
            "institutional-duty",
            "moral-alignment",
            "retaliation-predictability",
            "protectiveness",
            "self-interest-reliability",
            "other"
          ]
        },
        "otherDomain": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "choiceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "classification",
        "confidence"
      ],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "array",
          "items": {
            "enum": [
              "free",
              "pressured",
              "coerced",
              "structurally-constrained",
              "role-obligated",
              "materially-dependent",
              "threatened",
              "no-meaningful-alternative-perceived",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "perceivedConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analystVisibleConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "thirdPartyModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holderActorId",
        "aboutActorId",
        "representedByActorId",
        "modelStatement",
        "confidence"
      ],
      "properties": {
        "holderActorId": {
          "type": "string",
          "minLength": 1
        },
        "aboutActorId": {
          "type": "string",
          "minLength": 1
        },
        "representedByActorId": {
          "type": "string",
          "minLength": 1
        },
        "modelStatement": {
          "type": "string",
          "minLength": 1
        },
        "discrepancyAssessment": {
          "enum": [
            "none",
            "small",
            "material",
            "large",
            "unknown"
          ]
        },
        "strategicUse": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "influenceTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "modelUpdate",
        "decisionOrBehavior",
        "consequence"
      ],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "modelUpdate": {
          "type": "string",
          "minLength": 1
        },
        "decisionOrBehavior": {
          "type": "string",
          "minLength": 1
